@model IPFMMS.ViewModels.PayRoutineBillViewModel
@{ ViewData["Title"]="Record Bill Payment"; Layout="_DashboardLayout"; var today=DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(8)).Date; }
<div class="container-fluid py-4" style="max-width:1000px">
<h2 class="fw-bold">Record Bill Payment</h2><p class="text-muted">Confirm a payment you have already made. This records an expense; it does not charge your bank account.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
<h3 class="h5 fw-bold text-break">@Model.Bill?.billName</h3><p>@Model.Bill?.ExpenseCategory?.CategoryName � Scheduled for @Model.Bill?.dueDate.ToString("dd MMM yyyy")</p>
<p class="small text-muted">Record the full payment for this occurrence. The amount can differ from the estimate. Recurring bills advance by one scheduled occurrence, including when overdue. Payments are available for the current or past due months.</p>
<form asp-action="Pay" asp-route-id="@Model.BillId" method="post">
<input asp-for="BillId" type="hidden"/><input asp-for="EditStamp" type="hidden"/>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-4"><label asp-for="Amount" class="form-label"></label><div class="input-group"><span class="input-group-text">RM</span><input asp-for="Amount" asp-format="{0:0.00}" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]{1,2})?" class="form-control"/></div><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="PaidDate" class="form-label"></label><input asp-for="PaidDate" type="date" min="1000-01-01" max="@today.ToString("yyyy-MM-dd")" class="form-control"/><span asp-validation-for="PaidDate" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select">@foreach(var method in RoutineBillOptions.PaymentMethods){<option value="@method">@method</option>}</select><span asp-validation-for="PaymentMethod" class="text-danger"></span></div>
<div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Confirm payment</button></div>
</form></div></div></div>
@section Scripts {<script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial" />}

