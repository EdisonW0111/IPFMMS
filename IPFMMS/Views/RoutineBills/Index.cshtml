@model IPFMMS.ViewModels.RoutineBillIndexViewModel
@{ ViewData["Title"]="Routine Bills & Subscriptions"; Layout="_DashboardLayout"; }
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap gap-3 justify-content-between mb-4"><div><h2 class="fw-bold">Routine Bills &amp; Subscriptions</h2><p class="text-muted mb-0">Keep track of scheduled payments and upcoming due dates.</p></div><div><a asp-action="History" class="btn btn-outline-secondary me-2">Payment history</a><a asp-action="Create" class="btn btn-primary">Add bill or subscription</a></div></div>
    @if(TempData["SuccessMessage"] is string success){<div class="alert alert-success" role="status">@success</div>}
    @if(TempData["WarningMessage"] is string warning){<div class="alert alert-warning" role="alert">@warning</div>}
    <div class="row g-3 mb-4"><div class="col-12 col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="text-muted small">Active bills</div><div class="h2 fw-bold mb-0">@Model.ActiveCount</div></div></div></div><div class="col-12 col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="text-muted small">Next due date within 30 days</div><div class="h2 fw-bold mb-0">@Model.UpcomingCount</div></div></div></div><div class="col-12 col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="text-muted small">Overdue</div><div class="h2 fw-bold @(Model.OverdueCount>0?"text-danger":"") mb-0">@Model.OverdueCount</div></div></div></div></div>
    <section class="card border-0 shadow-sm"><div class="card-body p-4">
        <h3 class="h5 fw-bold">Scheduled bills and subscriptions</h3>
        <p class="small text-muted">Summary cards cover all your saved schedules. Filters apply to the list below.</p>
        <form asp-action="Index" method="get" id="routineBillFilters" class="row g-3 align-items-start mb-4">
            <div class="col-12 col-lg-5"><label for="scheduledBillSearch" class="form-label">Search</label><input id="scheduledBillSearch" name="search" type="search" value="@Model.Search" maxlength="100" placeholder="Bill name or expense category" class="form-control"/></div>
            <div class="col-12 col-sm-6 col-lg-3"><label for="scheduledBillType" class="form-label">Type</label><select id="scheduledBillType" name="type" class="form-select"><option value="all" selected="@(Model.Type=="all")">All types</option>@foreach(var type in RoutineBillOptions.Types){<option value="@type" selected="@(Model.Type==type)">@type</option>}</select></div>
            <div class="col-12 col-sm-6 col-lg-4"><label for="scheduledBillStatus" class="form-label">Status</label><select id="scheduledBillStatus" name="status" class="form-select">@foreach(var status in new[]{"all","Active","Upcoming","DueToday","Overdue","Inactive","Completed"}){<option value="@status" selected="@(Model.Status==status)">@(status switch{"all"=>"All statuses","Active"=>"Active (all dates)","Upcoming"=>"Upcoming (next 30 days)","DueToday"=>"Due today",_=>status})</option>}</select></div>
            <div class="col-12 d-flex gap-2"><button id="routineBillFilterButton" type="submit" class="btn btn-primary">Filter</button><a id="routineBillReset" asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
        </form>
        <div id="routineBillFilterError" class="alert alert-warning" role="alert" hidden>Could not load bills. Your previous results remain displayed. Please try again.</div>
        <partial name="_ScheduledBillResults" model="Model"/>
    </div></section>
</div>



@section Scripts{<script src="~/js/routine-bill-filters.js" asp-append-version="true"></script>}
