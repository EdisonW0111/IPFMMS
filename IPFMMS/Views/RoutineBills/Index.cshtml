@model IPFMMS.ViewModels.RoutineBillIndexViewModel
@{ ViewData["Title"]="Routine Bills & Subscriptions"; Layout="_DashboardLayout"; }
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap gap-3 justify-content-between mb-4"><div><h2 class="fw-bold">Routine Bills &amp; Subscriptions</h2><p class="text-muted mb-0">Keep track of scheduled payments and upcoming due dates.</p></div><div><a asp-action="History" class="btn btn-outline-secondary me-2">Payment history</a><a asp-action="Create" class="btn btn-primary">Add bill or subscription</a></div></div>
    @if(TempData["SuccessMessage"] is string success){<div class="alert alert-success" role="status">@success</div>}
    @if(TempData["WarningMessage"] is string warning){<div class="alert alert-warning" role="alert">@warning</div>}
    <div class="row g-3 mb-4"><div class="col-12 col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="text-muted small">Active bills</div><div class="h2 fw-bold mb-0">@Model.ActiveCount</div></div></div></div><div class="col-12 col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="text-muted small">Next due date within 30 days</div><div class="h2 fw-bold mb-0">@Model.UpcomingCount</div></div></div></div><div class="col-12 col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="text-muted small">Overdue</div><div class="h2 fw-bold @(Model.OverdueCount>0?"text-danger":"") mb-0">@Model.OverdueCount</div></div></div></div></div>
    <section class="card border-0 shadow-sm"><div class="card-body p-4">
        <h3 class="h5 fw-bold">Scheduled bills and subscriptions</h3>
        @if(Model.Bills.Count==0){<p class="text-muted mb-0">No bills yet. Add your first scheduled payment to get started.</p>}
        else{
            <p class="small text-muted d-md-none">Swipe the table to see all columns.</p>
            <div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Name</th><th>Type</th><th>Category</th><th class="text-end">Amount (RM)</th><th>Next due date</th><th>Frequency</th><th>Reminder</th><th>Status</th><th style="width:240px;min-width:240px">Actions</th></tr></thead><tbody>
                @foreach(var bill in Model.Bills){var display=Model.DisplayStatus(bill);<tr><th scope="row" class="fw-normal">@bill.billName</th><td>@bill.billType</td><td>@bill.ExpenseCategory?.CategoryName</td><td class="text-end">@bill.amount.ToString("N2")</td><td>@bill.dueDate.ToString("dd MMM yyyy")</td><td>@RoutineBillOptions.FrequencyLabel(bill.frequency)</td><td>@(bill.reminderPeriod==0?"On due date":bill.reminderPeriod+" day(s) before")</td><td><span class="badge @(display=="Overdue"?"bg-danger":display=="Due today"?"bg-warning text-dark":display=="Upcoming"?"bg-info text-dark":"bg-secondary")">@display</span></td><td><div class="d-flex align-items-center gap-2 flex-nowrap" style="min-width:216px">@if(bill.status=="Active"&&bill.dueDate<new DateTime(Model.Today.Year,Model.Today.Month,1).AddMonths(1)){<a asp-action="Pay" asp-route-id="@bill.billId" class="btn btn-sm btn-primary text-nowrap">Mark as paid</a>}<a asp-action="Edit" asp-route-id="@bill.billId" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@bill.billId" class="btn btn-sm btn-outline-danger">Delete</a></div></td></tr>}
            </tbody></table></div>
            @if(Model.Pages>1){<nav aria-label="Scheduled bill pages" class="d-flex gap-2 align-items-center mt-3">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-outline-secondary">Next</a>}</nav>}
        }
    </div></section>
</div>


