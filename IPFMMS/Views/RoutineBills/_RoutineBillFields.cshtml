@model IPFMMS.ViewModels.CreateRoutineBillViewModel
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
            @if(Model.Categories.Count==0){<div class="alert alert-info">No active expense categories are available.</div>}
            <div class="mb-4"><label asp-for="BillName" class="form-label"></label><input asp-for="BillName" class="form-control" maxlength="100" placeholder="For example, electricity or Netflix" required /><span asp-validation-for="BillName" class="text-danger"></span></div>
            <div class="row g-3 mb-4"><div class="col-12 col-md-6"><label asp-for="BillType" class="form-label"></label><select asp-for="BillType" class="form-select">@foreach(var type in RoutineBillOptions.Types){<option value="@type">@type</option>}</select><span asp-validation-for="BillType" class="text-danger"></span></div><div class="col-12 col-md-6"><label asp-for="ExpenseCategoryId" class="form-label"></label><select asp-for="ExpenseCategoryId" asp-items="Model.Categories" class="form-select" required><option value="">Select expense category</option></select><span asp-validation-for="ExpenseCategoryId" class="text-danger"></span></div></div>
            <div class="mb-4"><label asp-for="Amount" class="form-label"></label><div class="input-group"><span class="input-group-text">RM</span><input asp-for="Amount" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]{1,2})?" class="form-control" placeholder="0.00" required /></div><span asp-validation-for="Amount" class="text-danger"></span></div>
            <div class="row g-3 mb-4"><div class="col-12 col-md-6"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" type="date" asp-format="{0:yyyy-MM-dd}" min="1000-01-01" class="form-control" required /><span asp-validation-for="DueDate" class="text-danger"></span><p class="small text-muted mt-1 mb-0">Choose the next unpaid date. Past dates appear as overdue.</p></div><div class="col-12 col-md-6"><label asp-for="Frequency" class="form-label"></label><select asp-for="Frequency" class="form-select">@foreach(var frequency in RoutineBillOptions.Frequencies){<option value="@frequency">@RoutineBillOptions.FrequencyLabel(frequency)</option>}</select><span asp-validation-for="Frequency" class="text-danger"></span></div></div>
            <div class="row g-3 mb-4"><div class="col-12 col-md-6"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select" required><option value="">Select payment method</option>@foreach(var method in RoutineBillOptions.PaymentMethods){<option value="@method">@method</option>}</select><span asp-validation-for="PaymentMethod" class="text-danger"></span></div><div class="col-12 col-md-6"><label asp-for="ReminderPeriod" class="form-label"></label><input asp-for="ReminderPeriod" type="number" min="0" max="365" step="1" class="form-control" /><span asp-validation-for="ReminderPeriod" class="text-danger"></span><p class="small text-muted mt-1 mb-0">0 means on the due date; otherwise 1–365 days before.</p></div></div>
            <div class="mb-4"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3" maxlength="500" placeholder="Optional notes"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
