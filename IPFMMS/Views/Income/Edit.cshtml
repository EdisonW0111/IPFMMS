@model IPFMMS.ViewModels.EditIncomeViewModel

@{
    ViewData["Title"] = "Edit Income";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">

            <!-- Page Heading -->
            <div class="mb-4">

                <h2 class="fw-bold mb-1">
                    Edit Income
                </h2>

                <p class="text-muted mb-0">
                    Update your existing income transaction details.
                </p>

            </div>

            <!-- Edit Income Card -->
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Income"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Keep the original income ID -->
                        <input asp-for="IncomeId"
                               type="hidden" />

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Income Category -->
                        <div class="mb-4">

                            <label asp-for="IncomeCategoryId"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="IncomeCategoryId"
                                    asp-items="Model.IncomeCategories"
                                    class="form-select">

                                <option value="">
                                    -- Select Income Category --
                                </option>

                            </select>

                            <span asp-validation-for="IncomeCategoryId"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Amount -->
                        <div class="mb-4">

                            <label asp-for="Amount"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    RM
                                </span>

                                <input asp-for="Amount"
                                       type="number"
                                       min="0.01"
                                       max="999999999.99"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Income Date -->
                        <div class="mb-4">

                            <label asp-for="IncomeDate"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="IncomeDate"
                                   type="date"
                                   asp-format="{0:yyyy-MM-dd}"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />

                            <span asp-validation-for="IncomeDate"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"
                                      maxlength="255"
                                      placeholder="Enter an optional description..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Maximum 255 characters.
                            </div>

                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end
                                    flex-wrap gap-2">

                            <a asp-controller="Transaction"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn text-white px-4"
                                    style="background-color: #16899a;">

                                <i class="bi bi-check-circle me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </form>

                    <!-- Delete Income -->
                    <div class="mt-4 pt-4 border-top">

                        <form asp-controller="Income"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to permanently delete this income? This action cannot be undone.');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.IncomeId" />

                            <button type="submit"
                                    class="btn btn-outline-danger">

                                <i class="bi bi-trash me-1"></i>
                                Delete Transaction

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}