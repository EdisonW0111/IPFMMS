@model IPFMMS.ViewModels.AdminCategoryIndexViewModel
@{ ViewData["Title"] = Model.Kind + " Categories"; Layout = "_DashboardLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page">
    <div class="admin-heading"><div><h2 class="fw-bold">@Model.Kind Categories</h2><p class="text-muted">Maintain the categories used to organise financial records.</p></div><a asp-action="Create" asp-route-kind="@Model.Kind" class="btn btn-primary">Add category</a></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["WarningMessage"] is string warning) { <div class="alert alert-warning" role="alert">@warning</div> }
    <nav class="admin-section-links mb-4" aria-label="Category types"><a asp-action="Index" asp-route-kind="Income" class="btn @(Model.Kind == "Income" ? "btn-primary" : "btn-outline-primary")" aria-current="@(Model.Kind == "Income" ? "page" : null)">Income categories</a><a asp-action="Index" asp-route-kind="Expense" class="btn @(Model.Kind == "Expense" ? "btn-primary" : "btn-outline-primary")" aria-current="@(Model.Kind == "Expense" ? "page" : null)">Expense categories</a></nav>
    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><form asp-action="Index" method="get" data-admin-filters data-results="adminCategoryResults"><input name="kind" type="hidden" value="@Model.Kind" /><div class="admin-filter-grid admin-two-filters">
        <div><label for="categorySearch" class="form-label">Search categories</label><input id="categorySearch" type="search" name="search" value="@Model.Search" maxlength="100" placeholder="Category name or description" class="form-control" /></div><div><label for="categoryStatus" class="form-label">Status</label><select id="categoryStatus" name="status" class="form-select">@foreach (var status in new[] { "All", "Active", "Inactive" }) { <option value="@status" selected="@(Model.Status == status)">@status</option> }</select></div><div class="admin-filter-actions"><button type="submit" class="btn btn-primary" data-admin-submit>Filter</button><a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary" data-admin-reset>Reset</a></div>
    </div><div class="alert alert-danger mt-3 mb-0" data-admin-error hidden role="alert">Categories could not be loaded. Your previous results are still shown. Try filtering again.</div></form></div></div>
    <partial name="_CategoryResults" model="Model" />
</div>
@section Scripts { <script src="~/js/admin-filters.js" asp-append-version="true"></script> }
