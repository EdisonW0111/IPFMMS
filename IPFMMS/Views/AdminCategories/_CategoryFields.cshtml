@model IPFMMS.ViewModels.AdminCategoryFormViewModel
<input asp-for="Kind" type="hidden" /><input asp-for="CategoryId" type="hidden" /><input asp-for="EditStamp" type="hidden" />
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<div class="mb-3"><label asp-for="CategoryName" class="form-label">Category name</label><input asp-for="CategoryName" class="form-control" maxlength="100" readonly="@Model.IsProtectedName" /><span asp-validation-for="CategoryName" class="text-danger small"></span>@if (Model.IsProtectedName) { <div class="form-text">This system category name is required for linked payments or savings records and is kept unchanged.</div> }</div>
<div class="mb-3"><label asp-for="Description" class="form-label">Description (optional)</label><textarea asp-for="Description" class="form-control" rows="3" maxlength="255"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="DisplayOrder" class="form-label">Display order</label><input asp-for="DisplayOrder" class="form-control" type="number" min="0" step="1" /><div class="form-text">Lower numbers appear first in category lists.</div><span asp-validation-for="DisplayOrder" class="text-danger small"></span></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active category</label></div>
<p class="small text-muted">Inactive categories are unavailable for new records. Existing records keep their category.</p>
@if (Model.IsProtectedName) { <div class="alert alert-warning">Deactivating this system category can prevent new linked debt payments or shared savings entries that require it.</div> }
