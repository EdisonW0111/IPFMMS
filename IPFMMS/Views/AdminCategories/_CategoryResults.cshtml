@model IPFMMS.ViewModels.AdminCategoryIndexViewModel
<div id="adminCategoryResults" aria-live="polite" class="card border-0 shadow-sm"><div class="card-body p-4"><div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><h3 class="h5 fw-bold mb-0">@Model.Kind categories</h3><span class="text-muted">@Model.Count matching category(ies)</span></div>
    @if (Model.Categories.Count == 0) { <p class="text-muted mb-0">No categories match these filters.</p> }
    else {
        <p class="small text-muted d-md-none">Swipe the table to see all columns.</p><div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead class="table-light"><tr><th>Category</th><th>Status</th><th>Display order</th><th>Uses</th><th>Actions</th></tr></thead><tbody>
        @foreach (var category in Model.Categories) {
            <tr><td class="admin-user-cell"><strong>@category.CategoryName</strong>@if (category.IsProtectedName) { <span class="badge bg-secondary ms-1">System category</span> }<div class="small text-muted">@category.CategoryId</div>@if (!string.IsNullOrWhiteSpace(category.Description)) { <div class="small text-muted mt-1">@category.Description</div> }</td><td><span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">@(category.IsActive ? "Active" : "Inactive")</span></td><td>@category.DisplayOrder</td><td>@category.UsageCount</td><td><div class="admin-actions"><a asp-action="Edit" asp-route-kind="@Model.Kind" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-primary">Edit</a>@if (category.CanDelete || category.IsActive) { <a asp-action="Delete" asp-route-kind="@Model.Kind" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-danger">@(category.CanDelete ? "Delete" : "Deactivate")</a> }</div></td></tr>
        }
        </tbody></table></div><p class="small text-muted mt-3 mb-0">Inactive categories stay attached to existing records. Used categories and system category names are preserved.</p>
        @if (Model.Pages > 1) { <nav class="admin-pagination" aria-label="Category pages"><span class="small text-muted">Page @Model.Page of @Model.Pages</span><div class="admin-actions">@if (Model.Page > 1) { <a asp-action="Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)" class="btn btn-sm btn-outline-secondary" data-admin-page>Previous</a> }@if (Model.Page < Model.Pages) { <a asp-action="Index" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)" class="btn btn-sm btn-outline-secondary" data-admin-page>Next</a> }</div></nav> }
    }
</div></div>
