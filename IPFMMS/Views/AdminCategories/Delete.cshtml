@model IPFMMS.ViewModels.AdminCategoryDeleteViewModel
@{ ViewData["Title"] = Model.CanDelete ? "Delete Category" : "Deactivate Category"; Layout = "_DashboardLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page"><div class="admin-form"><h2 class="fw-bold mb-4">@(Model.CanDelete ? "Delete category" : "Deactivate category")</h2><div class="card border-0 shadow-sm"><div class="card-body p-4"><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    @if (TempData["WarningMessage"] is string warning) { <div class="alert alert-warning" role="alert">@warning</div> }
    <dl class="row admin-detail-list"><dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.CategoryName</dd><dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.Kind</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd><dt class="col-sm-3">Uses</dt><dd class="col-sm-9">@Model.UsageCount</dd></dl>
    @if (Model.CanDelete) {
        <div class="alert alert-warning">This category is not used by any records. Deleting it permanently removes it from the category list.</div><form asp-action="Delete" asp-route-kind="@Model.Kind" asp-route-id="@Model.CategoryId" method="post"><input asp-for="CategoryId" type="hidden" /><input asp-for="EditStamp" type="hidden" /><div class="admin-confirm mb-4"><div class="form-check"><input id="confirmCategoryDelete" class="form-check-input" type="checkbox" required /><label for="confirmCategoryDelete" class="form-check-label">I want to permanently delete this category.</label></div></div><div class="admin-actions"><a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-danger">Delete category</button></div></form>
    } else {
        <div class="alert alert-info">@(Model.IsProtectedName ? "This system category cannot be deleted." : "This category is used by existing records and cannot be deleted.") Deactivating it keeps its history and prevents its use for new records.</div>
        @if (Model.IsProtectedName) { <div class="alert alert-warning">New debt payments or shared savings entries that require this category may be unavailable while it is inactive.</div> }
        @if (Model.IsActive) {
            <form asp-action="Deactivate" asp-route-kind="@Model.Kind" asp-route-id="@Model.CategoryId" method="post"><input name="stamp" type="hidden" value="@Model.EditStamp" /><div class="admin-confirm mb-4"><div class="form-check"><input id="confirmCategoryDeactivate" class="form-check-input" type="checkbox" required /><label for="confirmCategoryDeactivate" class="form-check-label">I want to deactivate this category and retain existing records.</label></div></div><div class="admin-actions"><a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-danger">Deactivate category</button></div></form>
        } else { <a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Back to categories</a> }
    }
</div></div></div></div>
