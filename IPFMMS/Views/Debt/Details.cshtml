@model IPFMMS.ViewModels.DebtDetailsViewModel

@{var d=Model.Debt;ViewData["Title"]="Debt Details";Layout="_DashboardLayout";var status=DebtOptions.DisplayStatus(d);}

<div class="container-fluid py-4"><div class="d-flex flex-wrap gap-3 justify-content-between mb-4"><div><h2 class="fw-bold text-break">@d.debtName</h2><p class="text-muted">@d.debtType · @status</p></div><div class="d-flex gap-2 flex-wrap align-items-start"><a asp-action="Index" class="btn btn-outline-secondary">Back to debts</a>@if(d.status=="Active"){<a asp-action="Repay" asp-route-id="@d.debtId" class="btn btn-primary">Record repayment</a>}@if(d.status!="Deleted"){<a asp-action="Edit" asp-route-id="@d.debtId" class="btn btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@d.debtId" class="btn btn-outline-danger">Delete</a>}</div></div><partial name="_Messages"/>
@if(d.calculationMode=="Calculated"){
<div class="alert alert-info"><strong>@(d.rateType=="Floating"?"Variable (floating)":"Fixed") rate · monthly reducing balance</strong><br/>Annual lending rate: @d.interestRate.ToString("0.####")%. @if(d.rateType=="Floating"){<span>@d.referenceRateName @d.referenceRate?.ToString("0.####")% + spread @d.rateSpread?.ToString("0.####")%.</span>}<br/>@d.loanTermMonths-month @(d.isExistingLoan?"remaining-term baseline":"original term"); @d.completedInstallments instalment period(s) completed. Paid interest recorded in this app: RM @Model.InterestPaid.ToString("N2").
<p class="small mb-0 mt-2">Planning estimate: annual rate ÷ 12, equal monthly periods, interest paid first. No fees, penalties, daily-rest calculations, redraw/offset facilities, or lender settlement rebates. Rate inputs come from your agreement and are not fetched automatically.</p>
@if(d.rateType=="Floating"&&d.status=="Active"){<a asp-action="Rate" asp-route-id="@d.debtId" class="btn btn-outline-primary btn-sm mt-3">Update floating rate</a>}
</div>}


@if(d.status=="Deleted"){<div class="alert alert-secondary">This debt was deleted from the active list. Its retained history is read-only.</div>}

<div class="row g-3 mb-4"><div class="col-12 col-md-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="small text-muted">Original amount</div><div class="h3 fw-bold text-break">RM @d.originalAmount.ToString("N2")</div></div></div></div><div class="col-12 col-md-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="small text-muted">Outstanding principal</div><div class="h3 fw-bold text-break">RM @d.outstandingAmount.ToString("N2")</div></div></div></div><div class="col-12 col-md-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="small text-muted">Principal repaid</div><div class="h3 fw-bold text-success text-break">RM @((d.originalAmount-d.outstandingAmount).ToString("N2"))</div><div class="small text-muted">@DebtOptions.Progress(d).ToString("0.#")% of original amount</div></div></div></div><div class="col-12 col-md-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="small text-muted">Monthly repayment plan</div><div class="h3 fw-bold text-break">RM @d.monthlyRepaymentAmount.ToString("N2")</div></div></div></div></div>

<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><div class="row g-3"><div class="col-12 col-md-4"><strong>Next due date</strong><div>@d.dueDate.ToString("dd MMM yyyy")</div></div><div class="col-12 col-md-4"><strong>Annual interest rate</strong><div>@d.interestRate.ToString("0.####")%</div></div><div class="col-12 col-md-4"><strong>Recorded in this app</strong><div>RM @Model.RecordedPaid.ToString("N2")</div></div></div><p class="small text-muted mt-3 mb-0">Earlier principal repayments: RM @((d.originalAmount-d.openingOutstandingAmount).ToString("N2")). These are included in progress but are not new expenses. @(d.calculationMode=="Calculated"?"Interest is estimated at monthly intervals and allocated when repayments are recorded; this is not a bank settlement quote.":"Manual tracking: interest is information only; the full repayment reduces the entered balance.")</p>@if(!string.IsNullOrEmpty(d.description)){<p class="text-break mt-3 mb-0" style="white-space:pre-wrap">@d.description</p>}</div></div>

@if(Model.Schedule.Count>0){<details class="card border-0 shadow-sm mb-4"><summary class="p-4 fw-bold">Estimated remaining repayment schedule (@Model.Schedule.Count period(s))</summary><div class="card-body p-4 pt-0"><p class="small text-muted">Assumes the current rate continues and instalments are paid as scheduled. Extra principal payments can shorten the term. The final payment is adjusted for cents. No interest is charged by simply viewing this schedule.</p><div class="table-responsive"><table class="table" style="min-width:650px"><thead><tr><th>Period</th><th>Payment (RM)</th><th>Principal</th><th>Interest</th><th>Closing principal</th></tr></thead><tbody>@foreach(var row in Model.Schedule){<tr><td>@row.Number</td><td>@row.Payment.ToString("N2")</td><td>@row.Principal.ToString("N2")</td><td>@row.Interest.ToString("N2")</td><td>@row.ClosingPrincipal.ToString("N2")</td></tr>}</tbody></table></div></div></details>}
@if(Model.RateChanges.Count>0){<details class="card border-0 shadow-sm mb-4"><summary class="p-4 fw-bold">Floating-rate change history</summary><div class="card-body p-4 pt-0"><p class="small text-muted">Most recent 50 changes. Past repayment allocations remain unchanged.</p><div class="table-responsive"><table class="table"><thead><tr><th>Effective scheduled date</th><th>Previous rate</th><th>New rate</th><th>New monthly estimate</th></tr></thead><tbody>@foreach(var c in Model.RateChanges){<tr><td>@c.effectiveDueDate.ToString("dd MMM yyyy")</td><td>@c.previousRate.ToString("0.####")%</td><td>@c.newRate.ToString("0.####")%</td><td>RM @c.monthlyPayment.ToString("N2")</td></tr>}</tbody></table></div></div></details>}
<div class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5 fw-bold">Repayment history</h3><p class="small text-muted">Each recorded repayment links to one expense and counts toward spending on its payment date. These entries are read-only.</p>

<form asp-action="Details" asp-route-id="@d.debtId" method="get" class="d-flex flex-wrap gap-3 align-items-start mb-3" data-debt-filters data-results="debtHistoryResults"><input name="id" value="@d.debtId" type="hidden"/>@if(Model.ExpenseId!=null){<input name="expenseId" value="@Model.ExpenseId" type="hidden"/>}<div><label for="repaymentMonth" class="form-label">Payment month</label><input id="repaymentMonth" name="month" type="month" min="1000-01" max="9998-12" value="@Model.Month" class="form-control"/><div class="form-text">Leave blank for all months.</div></div><div class="d-flex gap-2" style="padding-top:32px"><button data-filter-submit type="submit" class="btn btn-primary">Filter</button><a data-debt-reset asp-action="Details" asp-route-id="@d.debtId" class="btn btn-outline-secondary">Reset</a></div></form>

<div class="alert alert-warning" data-debt-error role="alert" hidden>Could not load history. Previous results are retained.</div><partial name="_RepaymentHistory" model="Model"/>

</div></div></div>

@section Scripts{<script src="~/js/debt-filters.js" asp-append-version="true"></script>}
