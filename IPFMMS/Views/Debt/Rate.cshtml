@model IPFMMS.ViewModels.DebtRateViewModel
@{ViewData["Title"]="Update Floating Rate";Layout="_DashboardLayout";}
<div class="container-fluid py-4" style="max-width:850px"><h2 class="fw-bold">Update Floating Rate</h2><p class="text-muted text-break">@Model.Debt?.debtName</p><div class="card border-0 shadow-sm"><div class="card-body p-4"><p>This updates the estimate from the next unpaid scheduled instalment on <strong>@Model.Debt?.dueDate.ToString("dd MMM yyyy")</strong>, using the remaining principal and term. Past repayments and interest allocations remain unchanged.</p><p class="small text-muted">Enter the lender's revised reference rate and spread. Changes are not fetched automatically. Finish an overdue or partially paid period at its existing rate first.</p><form asp-action="Rate" asp-route-id="@Model.DebtId" method="post"><input asp-for="DebtId" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="mb-4"><label asp-for="ReferenceRate" class="form-label">Reference rate (% p.a.)</label><input asp-for="ReferenceRate" type="text" inputmode="decimal" class="form-control"/></div><div class="mb-4"><label asp-for="Spread" class="form-label">Spread (% p.a.)</label><input asp-for="Spread" type="text" inputmode="decimal" class="form-control"/></div><div class="d-flex flex-wrap justify-content-end gap-2"><a asp-action="Details" asp-route-id="@Model.DebtId" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Update future instalments</button></div></form></div></div></div>
