@model IPFMMS.Models.Debt
@{ViewData["Title"]="Delete Debt";Layout="_DashboardLayout";}
<div class="container-fluid py-4" style="max-width:850px"><h2 class="fw-bold">Delete Debt</h2><partial name="_Messages"/><div class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5 text-break">@Model.debtName</h3><p>Outstanding: RM @Model.outstandingAmount.ToString("N2")</p><p>This removes the debt from your list and summary. Repayment history and linked expenses are retained and remain accessible from Transactions.</p><form asp-action="DeleteConfirmed" method="post"><input type="hidden" name="id" value="@Model.debtId"/><input type="hidden" name="revision" value="@Model.revision"/><div class="d-flex justify-content-end gap-2"><a asp-action="Details" asp-route-id="@Model.debtId" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-danger">Delete debt</button></div></form></div></div></div>
