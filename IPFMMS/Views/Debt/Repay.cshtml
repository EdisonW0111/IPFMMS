@model IPFMMS.ViewModels.DebtRepayViewModel
@{ViewData["Title"]="Record Debt Repayment";Layout="_DashboardLayout";}
<div class="container-fluid py-4" style="max-width:1000px"><h2 class="fw-bold">Record Debt Repayment</h2><p class="text-muted">Record a payment you have made. This creates an expense; it does not transfer money.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><h3 class="h5 fw-bold text-break">@Model.Debt?.debtName</h3><p>Outstanding principal: <strong>RM @Model.Debt?.outstandingAmount.ToString("N2")</strong></p>
@if(Model.Debt?.calculationMode=="Calculated"){
<div class="alert alert-info">Scheduled period: @Model.Debt.dueDate.ToString("dd MMM yyyy").<br/>Unpaid monthly interest estimate: <strong>RM @Model.EstimatedInterestDue.ToString("N2")</strong>.<br/>Maximum for this period: <strong>RM @Model.MaximumPayment.ToString("N2")</strong> (remaining principal plus this period's unpaid interest).<p class="small mb-0 mt-2">Payments cover this period's interest first, then principal. Partial payments keep the same due date; reaching the scheduled instalment advances one month. Extra money reduces principal. This is a monthly model, not a lender's early-settlement quote.</p></div>
}
<form asp-action="Repay" asp-route-id="@Model.DebtId" method="post"><input asp-for="DebtId" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-4"><label asp-for="Amount" class="form-label"></label><div class="input-group"><span class="input-group-text">RM</span><input asp-for="Amount" asp-format="{0:0.00}" type="text" inputmode="decimal" class="form-control"/></div><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="PaymentDate" class="form-label"></label><input asp-for="PaymentDate" type="date" min="1000-01-01" max="@DebtOptions.Today.ToString("yyyy-MM-dd")" class="form-control"/><span asp-validation-for="PaymentDate" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select">@foreach(var m in RoutineBillOptions.PaymentMethods){<option value="@m">@m</option>}</select><span asp-validation-for="PaymentMethod" class="text-danger"></span></div>
@if(Model.Debt?.calculationMode!="Calculated"){<div class="mb-4"><label asp-for="NextDueDate" class="form-label"></label><input asp-for="NextDueDate" type="date" min="1000-01-01" class="form-control"/><span asp-validation-for="NextDueDate" class="text-danger"></span><div class="form-text">Current due date: @Model.Debt?.dueDate.ToString("dd MMM yyyy"). Set a later date if this repayment advances your schedule. Leave blank to keep the current due date. Ignored when fully repaid.</div></div>
}
<div class="mb-4"><label asp-for="Remark" class="form-label">Remarks (optional)</label><textarea asp-for="Remark" rows="3" maxlength="500" class="form-control"></textarea><span asp-validation-for="Remark" class="text-danger"></span></div>
<p class="small text-muted">This repayment creates one expense in Debt Repayment. Avoid recording the same payment separately in Transactions.</p>
<div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-action="Details" asp-route-id="@Model.DebtId" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Record repayment</button></div></form></div></div></div>
@section Scripts{<script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial"/>}
