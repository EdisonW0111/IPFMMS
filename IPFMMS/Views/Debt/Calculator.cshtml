@model IPFMMS.ViewModels.LoanCalculatorViewModel
@{ViewData["Title"]="Loan Calculator";Layout="_DashboardLayout";}
<div class="container-fluid py-4" style="max-width:1100px"><div class="d-flex justify-content-between flex-wrap gap-3 mb-4"><div><h2 class="fw-bold">Loan Calculator</h2><p class="text-muted">Estimate monthly repayments before adding a loan.</p></div><div><a asp-action="Index" class="btn btn-outline-secondary">Back to debts</a></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><form id="loanCalculatorForm" asp-action="Calculator" method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row g-3">
<div class="col-12 col-md-6"><label asp-for="Principal" class="form-label">Principal financed (RM)</label><input asp-for="Principal" type="text" inputmode="decimal" class="form-control"/></div>
<div class="col-12 col-md-6"><label asp-for="Months" class="form-label">Term (months)</label><input asp-for="Months" type="number" min="1" max="480" class="form-control"/></div>
<div class="col-12 col-md-6"><label asp-for="RateType" class="form-label">Rate type</label><select asp-for="RateType" class="form-select"><option value="Fixed">Fixed</option><option value="Floating">Variable (floating)</option></select></div>
<div class="col-12 col-md-6"><label asp-for="Method" class="form-label">Interest method</label><select asp-for="Method" class="form-select"><option value="ReducingBalance">Reducing balance</option><option value="FlatRate">Legacy flat rate (comparison only)</option></select></div>
<fieldset id="calculatorFixedFields" class="col-12"><label asp-for="AnnualRate" class="form-label">Fixed annual rate (% p.a.)</label><input asp-for="AnnualRate" type="text" inputmode="decimal" class="form-control"/></fieldset>
<fieldset id="calculatorFloatingFields" class="col-12"><legend class="h6">Variable rate inputs</legend><div class="row g-3"><div class="col-12 col-md-6"><label asp-for="ReferenceRate" class="form-label">Floating reference rate (% p.a.)</label><input asp-for="ReferenceRate" type="text" inputmode="decimal" class="form-control"/></div><div class="col-12 col-md-6"><label asp-for="Spread" class="form-label">Floating spread (% p.a.)</label><input asp-for="Spread" type="text" inputmode="decimal" class="form-control"/></div></div><p id="calculatorCombinedRate" class="form-text mb-0" aria-live="polite"></p></fieldset></div>
<p id="calculatorRateHint" class="small text-muted mt-3">Fixed uses the fixed annual rate. Floating uses reference + spread from your lender; the fixed field is ignored. No live OPR lookup. The reducing-balance model uses annual lending rate ÷ 12 and equal monthly intervals. A variable-rate projection assumes today's entered rate remains unchanged.</p><button class="btn btn-primary" type="submit">Calculate estimate</button></form></div></div>
@if(Model.Quote!=null){<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h3 class="h5">@(Model.Method=="FlatRate"?"Legacy flat-rate comparison":"Monthly reducing-balance estimate")</h3><div class="row g-3"><div class="col-12 col-md-4"><div>Monthly estimate</div><strong class="h3">RM @Model.Quote.MonthlyPayment.ToString("N2")</strong></div><div class="col-12 col-md-4"><div>Total estimated interest</div><strong class="h3">RM @Model.Quote.TotalInterest.ToString("N2")</strong></div><div class="col-12 col-md-4"><div>Total estimated repayment</div><strong class="h3">RM @Model.Quote.TotalRepayment.ToString("N2")</strong></div></div><p class="small text-muted mt-3 mb-0">Final instalment can differ due to rounding. Estimates exclude fees, daily-rest interest, insurance, penalties and settlement rebates. A flat rate and a reducing-balance lending rate with the same number are not equivalent.</p></div></div>}
@if(Model.Schedule.Count>0){<details class="card border-0 shadow-sm mb-4"><summary class="p-4 fw-bold">Estimated principal and interest schedule</summary><div class="card-body p-4 pt-0"><div class="table-responsive"><table class="table" style="min-width:650px"><thead><tr><th>Month</th><th>Payment</th><th>Principal</th><th>Interest</th><th>Balance</th></tr></thead><tbody>@foreach(var row in Model.Schedule){<tr><td>@row.Number</td><td>@row.Payment.ToString("N2")</td><td>@row.Principal.ToString("N2")</td><td>@row.Interest.ToString("N2")</td><td>@row.ClosingPrincipal.ToString("N2")</td></tr>}</tbody></table></div></div></details>}
<p class="small text-muted">Malaysia's hire-purchase changes took effect on 1 June 2026, with a transition through 31 March 2027. Fixed does not mean flat, and floating does not mean a flexi/offset facility. Calculated loan tracking here uses reducing balance. For an existing flat-rate/Rule-of-78 agreement, use manual tracking with your lender's balance; this comparison does not calculate statutory settlement rebates or bank goodwill discounts. <a href="https://www.abm.org.my/press-releases/banks-in-malaysia-introduce-changes-to-hire-purchase-financing-with-early-settlement-discounts/" target="_blank" rel="noopener noreferrer">Read the Malaysian banking industry's explanation</a>.</p>
<a asp-action="Create" class="btn btn-primary">Add a debt or calculated loan</a></div>

@section Scripts{<script src="~/js/loan-calculator-fields.js" asp-append-version="true"></script>}
