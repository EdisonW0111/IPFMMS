@model IPFMMS.ViewModels.DebtIndexViewModel
<div id="debtResults" aria-live="polite"><p class="small text-muted">@Model.Count matching debt(s)</p>
@if(Model.Count==0){<p class="mb-0">No debts match these filters.</p>}else{
<p class="small text-muted d-md-none">Swipe the table to see all details and actions.</p>
<div class="table-responsive"><table class="table align-middle" style="min-width:1120px"><thead class="table-light"><tr><th style="min-width:180px">Debt</th><th class="text-end">Principal balance (RM)</th><th class="text-end">Monthly plan (RM)</th><th>Next due date</th><th>Progress</th><th>Status</th><th style="width:300px">Actions</th></tr></thead><tbody>
@foreach(var d in Model.Debts){var status=DebtOptions.DisplayStatus(d);var progress=DebtOptions.Progress(d);<tr><td><div class="fw-bold text-break" style="max-width:220px">@d.debtName</div><div class="small text-muted">@d.debtType</div></td><td class="text-end">@d.outstandingAmount.ToString("N2")</td><td class="text-end">@d.monthlyRepaymentAmount.ToString("N2")</td><td class="text-nowrap">@d.dueDate.ToString("dd MMM yyyy")</td><td style="min-width:110px"><div class="small mb-1">@progress.ToString("0.#")% principal repaid</div><div class="progress" style="height:6px" role="progressbar" aria-label="Repayment progress" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-success" style="width:@(progress.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div></td><td><span class="badge @(status=="Paid"?"bg-success":status=="Overdue"?"bg-danger":status=="Due today"?"bg-warning text-dark":status=="Inactive"?"bg-secondary":"bg-info text-dark")">@status</span></td><td><div class="d-flex gap-2 flex-nowrap"><a asp-action="Details" asp-route-id="@d.debtId" class="btn btn-sm btn-outline-secondary">Details</a>@if(d.status=="Active"){<a asp-action="Repay" asp-route-id="@d.debtId" class="btn btn-sm btn-primary">Repay</a>}<a asp-action="Edit" asp-route-id="@d.debtId" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@d.debtId" class="btn btn-sm btn-outline-danger">Delete</a></div></td></tr>}
</tbody></table></div>
@if(Model.Pages>1){<nav class="d-flex gap-2 align-items-center flex-wrap mt-3" aria-label="Debt pages">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-type="@Model.Type" class="btn btn-sm btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-type="@Model.Type" class="btn btn-sm btn-outline-secondary">Next</a>}</nav>}
}</div>
