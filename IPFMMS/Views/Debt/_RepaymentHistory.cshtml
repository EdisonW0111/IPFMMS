@model IPFMMS.ViewModels.DebtDetailsViewModel

<div id="debtHistoryResults" aria-live="polite"><p class="small text-muted">@Model.Count matching repayment(s)</p>

@if(Model.Count==0){<p class="mb-0">No repayments match this selection.</p>}else{

<p class="small text-muted d-md-none">Swipe the table to see all payment details.</p><div class="table-responsive"><table class="table align-middle" style="min-width:1000px"><thead class="table-light"><tr><th>Paid on</th><th class="text-end">Amount (RM)</th><th>Principal (RM)</th><th>Interest (RM)</th><th>Applied rate</th><th>Payment method</th><th>Remarks</th><th>Expense reference</th></tr></thead><tbody>@foreach(var p in Model.Repayments){<tr><td class="text-nowrap">@p.repaymentDate.ToString("dd MMM yyyy")</td><td class="text-end">@p.repaymentAmount.ToString("N2")</td><td>@p.principalAmount.ToString("N2")</td><td>@p.interestAmount.ToString("N2")</td><td>@(p.allocationMethod=="Calculated"?p.appliedInterestRate.ToString("0.####")+"%":"Manual")</td><td>@p.paymentMethod</td><td class="text-break" style="max-width:300px;white-space:pre-wrap">@(p.remark??"—")</td><td>@p.expenseId</td></tr>}</tbody></table></div>

@if(Model.Pages>1){<nav aria-label="Repayment history pages" class="d-flex flex-wrap gap-2 align-items-center mt-3">@if(Model.Page>1){<a asp-action="Details" asp-route-id="@Model.Debt.debtId" asp-route-page="@(Model.Page-1)" asp-route-month="@Model.Month" asp-route-expenseId="@Model.ExpenseId" class="btn btn-sm btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Details" asp-route-id="@Model.Debt.debtId" asp-route-page="@(Model.Page+1)" asp-route-month="@Model.Month" asp-route-expenseId="@Model.ExpenseId" class="btn btn-sm btn-outline-secondary">Next</a>}</nav>}

}</div>
