@model IPFMMS.ViewModels.ResetPasswordOtpViewModel

@{
    ViewData["Title"] = "Verify Reset Code";
    Layout = null;

    long resendDeadline = Model.ResendAvailableAtUtc.HasValue
        ? new DateTimeOffset(
            DateTime.SpecifyKind(
                Model.ResendAvailableAtUtc.Value,
                DateTimeKind.Utc
            )
          ).ToUnixTimeMilliseconds()
        : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Verify Reset Code - IPFMMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />
</head>

<body>
    <div class="forgot-container">
        <div class="forgot-card">

            <div class="forgot-logo">
                <img src="~/images/logo.png"
                     alt="IPFMMS Logo" />
            </div>

            <div class="forgot-icon">
                <i class="bi bi-envelope-check"></i>
            </div>

            <h1>Verify Reset Code</h1>

            <p class="forgot-description">
                Enter the six-digit verification code
                sent to your email address.
            </p>

            @if (TempData["ResetNotice"] != null)
            {
                <div class="alert alert-info" role="status">
                    @TempData["ResetNotice"]
                </div>
            }

            <form asp-controller="Account"
                  asp-action="VerifyResetOtp"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="forgot-form-group">
                    <label asp-for="Email"
                           class="forgot-label"></label>

                    <input asp-for="Email"
                           type="email"
                           class="forgot-input"
                           style="padding-left: 15px;"
                           autocomplete="email" 
                           readonly />

                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <div class="forgot-form-group">
                    <label asp-for="OtpCode"
                           class="forgot-label"></label>

                    <input asp-for="OtpCode"
                           class="forgot-input"
                           style="padding-left: 15px; text-align: center; letter-spacing: 7px;"
                           maxlength="6"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           placeholder="000000" />

                    <span asp-validation-for="OtpCode"
                          class="text-danger small"></span>
                </div>

                <button type="submit"
                        class="forgot-submit-button">
                    <i class="bi bi-check-circle"></i>
                    Verify Code
                </button>

            </form>

            <div class="reset-resend-section">

                <p>Didn't receive the verification code?</p>

                <form asp-controller="Account"
                      asp-action="ResendResetOtp"
                      method="post"
                      id="resendResetOtpForm">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            id="resendResetOtpButton"
                            class="reset-resend-button"
                            disabled="@(Model.ResendCooldownSeconds > 0)">
                        Resend Code
                    </button>

                    <span id="resetResendCountdown"
                          class="reset-resend-countdown">
                    </span>

                </form>

            </div>

            <div class="forgot-back">
                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   class="forgot-back-link">
                    <i class="bi bi-arrow-left"></i>
                    Back to Forgot Password
                </a>
            </div>

        </div>

        <p class="forgot-footer">
            © @DateTime.Now.Year IPFMMS.
            All rights reserved.
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const resendButton =
                document.getElementById("resendResetOtpButton");

            const countdownText =
                document.getElementById("resetResendCountdown");

            const resendForm =
                document.getElementById("resendResetOtpForm");

            if (!resendButton || !countdownText || !resendForm)
                return;

            const deadline = @resendDeadline;

            function updateCountdown() {
                const remaining = Math.max(
                    0,
                    Math.ceil((deadline - Date.now()) / 1000)
                );

                resendButton.disabled = remaining > 0;

                countdownText.textContent = remaining > 0
                    ? `Resend available in ${remaining}s`
                    : "";
            }

            updateCountdown();

            const timer = setInterval(() => {
                updateCountdown();

                if (Date.now() >= deadline) {
                    clearInterval(timer);
                }
            }, 1000);

            resendForm.addEventListener("submit", function () {
                resendButton.disabled = true;
                countdownText.textContent = "Sending...";
            });

        });
    </script>
</body>
</html>
