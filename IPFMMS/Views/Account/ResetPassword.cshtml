@inject IPFMMS.Services.UserPreferenceService Preferences
@model IPFMMS.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

@{ var ipfmmsTheme = await Preferences.ThemeAsync(User, Context.Request.Cookies["IPFMMS.Theme"]); }
<!DOCTYPE html>
<html lang="en" data-bs-theme="@ipfmmsTheme.ToLowerInvariant()">
<head>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Password - IPFMMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/reset-password.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>

<body>
    <div class="forgot-container">
        <div class="forgot-card">

            <div class="forgot-logo">
                <img src="~/images/logo.png"
                     alt="IPFMMS Logo" />
            </div>

            <div class="forgot-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>Create New Password</h1>

            <p class="forgot-description">
                Your email has been verified.
                Enter a new password to secure your account.
            </p>

            <form asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- New Password -->
                <div class="forgot-form-group">

                    <label asp-for="NewPassword"
                           class="forgot-label"></label>

                    <div class="reset-input-wrapper">

                        <input asp-for="NewPassword"
                               type="password"
                               class="reset-input"
                               placeholder="Enter new password"
                               autocomplete="new-password" />

                        <button type="button"
                                class="reset-password-toggle"
                                data-target="NewPassword"
                                aria-label="Show new password">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-danger small"></span>

                    <p class="reset-password-hint">
                        Minimum 8 characters, including uppercase,
                        lowercase, a number and a special character.
                    </p>

                </div>

                <!-- Confirm New Password -->
                <div class="forgot-form-group">

                    <label asp-for="ConfirmNewPassword"
                           class="forgot-label"></label>

                    <div class="reset-input-wrapper">

                        <input asp-for="ConfirmNewPassword"
                               type="password"
                               class="reset-input"
                               placeholder="Confirm new password"
                               autocomplete="new-password" />

                        <button type="button"
                                class="reset-password-toggle"
                                data-target="ConfirmNewPassword"
                                aria-label="Show confirmation password">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <span asp-validation-for="ConfirmNewPassword"
                          class="text-danger small"></span>

                </div>

                <button type="submit"
                        class="forgot-submit-button">
                    <i class="bi bi-check-circle"></i>
                    Reset Password
                </button>

            </form>

            <div class="forgot-back">
                <a asp-controller="Account"
                   asp-action="Login">
                    <i class="bi bi-arrow-left"></i>
                    Back to Login
                </a>
            </div>

        </div>

        <p class="forgot-footer">
            © @DateTime.Now.Year IPFMMS.
            All rights reserved.
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.querySelectorAll(".reset-password-toggle")
            .forEach(button => {

                button.addEventListener("click", function () {

                    const input = document.getElementById(
                        this.dataset.target
                    );

                    if (!input) return;

                    const isHidden = input.type === "password";

                    input.type = isHidden ? "text" : "password";

                    this.innerHTML = isHidden
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';

                    this.setAttribute(
                        "aria-label",
                        isHidden ? "Hide password" : "Show password"
                    );
                });
            });
    </script>
</body>
</html>