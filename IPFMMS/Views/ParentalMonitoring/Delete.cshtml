@model IPFMMS.ViewModels.MonitoringLinkViewModel
@{ ViewData["Title"]="Delete Relationship"; Layout="_DashboardLayout"; }
<div class="container-fluid py-4" style="max-width:850px">
    <h2 class="fw-bold">Delete Relationship</h2>
    <div class="card border-0 shadow-sm mt-4"><div class="card-body p-4">
        <h3 class="h5 fw-bold">@Model.OtherName</h3><p class="text-muted">Status: @Model.DisplayStatus</p>
        <p>Remove this relationship from your list? The other person's list and financial records will stay unchanged.</p>
        <p class="small text-muted">Any future request must be accepted again before monitoring is allowed.</p>
        <form asp-action="DeleteConfirmed" method="post" class="d-flex gap-2 flex-wrap"><input type="hidden" name="id" value="@Model.LinkId" /><input type="hidden" name="version" value="@Model.Version" /><a asp-action="Review" asp-route-id="@Model.LinkId" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-danger" type="submit">Delete from my list</button></form>
    </div></div>
</div>
