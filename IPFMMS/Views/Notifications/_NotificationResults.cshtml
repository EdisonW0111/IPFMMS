@model IPFMMS.ViewModels.NotificationsViewModel
<section id="notificationResults" data-unread-count="@Model.UnreadCount" aria-live="polite" aria-busy="false">
    @if(Model.UnreadCount>0){<form asp-action="MarkAllRead" method="post" class="mb-4"><input type="hidden" name="type" value="@Model.Type" /><input type="hidden" name="filterRead" value="@Model.Read" /><input type="hidden" name="page" value="@Model.Page" /><button class="btn btn-outline-secondary" type="submit">Mark all as read</button></form>}
    @if(Model.Notifications.Count==0){<div class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5 fw-bold">No matching notifications</h3><p class="text-muted mb-0">New bill reminders and monitoring alerts appear here when a check detects an eligible event.</p></div></div>}
    @foreach(var notification in Model.Notifications){
        <article class="card border-0 shadow-sm mb-3"><div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><h3 class="h5 fw-bold mb-0">@notification.title</h3><span class="badge @(notification.isRead ? "bg-secondary" : "bg-primary")">@(notification.isRead?"Read":"Unread")</span></div>
            <p class="small text-muted">@DateTime.SpecifyKind(notification.createdDateTime,DateTimeKind.Utc).AddHours(8).ToString("dd MMM yyyy HH:mm") MYT · @(notification.notificationType switch { "BudgetOverspending"=>"Budget overspending", "BillUpcoming"=>"Upcoming bill", "BillDueToday"=>"Bill due today", "BillOverdue"=>"Overdue bill", _=>"Low Financial Health" })</p>
            <p>@notification.message</p>
            <p class="small text-muted">Email: @(notification.emailStatus switch { "Sent" => "Sent", "Pending" => "Queued", "Sending" => "Sending", "Failed" => "Delivery failed", "Suppressed" => "Not sent — relationship unavailable", _ => "Not sent" })</p>
            @if(notification.emailStatus == "Failed"){<p class="small text-muted">You can retry email delivery after one minute. The in-app alert remains available.</p>}
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if(notification.routineBillId!=null){<a asp-controller="RoutineBills" asp-action="Index" class="btn btn-outline-primary btn-sm">View bills</a>}
                @if(notification.relatedUserId!=null){<a asp-controller="ParentalMonitoring" asp-action="Summary" asp-route-student="@notification.relatedUserId" asp-route-month="@notification.sourceMonth?.ToString("yyyy-MM")" class="btn btn-outline-primary btn-sm">View financial summary</a>}
                <form asp-action="SetRead" method="post"><input type="hidden" name="type" value="@Model.Type" /><input type="hidden" name="filterRead" value="@Model.Read" /><input type="hidden" name="page" value="@Model.Page" /><input type="hidden" name="id" value="@notification.notificationId" /><input type="hidden" name="read" value="@((!notification.isRead).ToString().ToLowerInvariant())" /><button class="btn btn-outline-secondary btn-sm" type="submit">@(notification.isRead?"Mark as unread":"Mark as read")</button></form>
                @if(notification.emailStatus == "Failed" || notification.emailStatus == "NotRequested"){
                    <form asp-action="SendEmail" method="post"><input type="hidden" name="id" value="@notification.notificationId" /><input type="hidden" name="type" value="@Model.Type" /><input type="hidden" name="filterRead" value="@Model.Read" /><input type="hidden" name="page" value="@Model.Page" /><button class="btn btn-outline-secondary btn-sm" type="submit" disabled="@(notification.emailAttemptedDate > DateTime.UtcNow.AddMinutes(-1))">@(notification.emailStatus == "Failed" ? "Retry email" : "Send email")</button></form>
                }
            </div>
        </div></article>
    }
    @if(Model.Pages>1){<nav aria-label="Notification pages" class="d-flex align-items-center gap-2 mt-4">
        @if(Model.Page>1){<a asp-action="Index" asp-route-type="@Model.Type" asp-route-read="@Model.Read" asp-route-page="@(Model.Page-1)" data-notification-page class="btn btn-outline-secondary btn-sm">Previous</a>}
        <span>Page @Model.Page of @Model.Pages</span>
        @if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-type="@Model.Type" asp-route-read="@Model.Read" asp-route-page="@(Model.Page+1)" data-notification-page class="btn btn-outline-secondary btn-sm">Next</a>}
    </nav>}

</section>
