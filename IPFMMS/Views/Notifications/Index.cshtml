@model IPFMMS.ViewModels.NotificationsViewModel
@{ ViewData["Title"]="Notifications"; Layout="_DashboardLayout"; }
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mb-4"><div><h2 class="fw-bold">Notifications</h2><p class="text-muted mb-0">Your financial alerts, invitations, bill reminders and monitoring updates.</p></div><div><span id="notificationPageUnread" class="badge bg-danger px-3 py-2">@Model.UnreadCount unread</span></div></div>
    <p class="small text-muted">Bill reminders follow your selected reminder days and also flag due-today and overdue bills. Monitoring checks use this month's records through today. Budget alerts are sent once per category/month and low-score alerts once per month for each accepted link. Alerts show figures when first detected; the summary shows current figures.</p>
    <form asp-action="Index" method="get" id="notificationFilters" class="d-flex flex-wrap gap-3 align-items-end mb-4">
        <div><label for="notificationType" class="form-label">Alert type</label><select id="notificationType" name="type" class="form-select"><option value="all" selected="@(Model.Type=="all")">All alerts</option><option value="BudgetOverspending" selected="@(Model.Type=="BudgetOverspending")">Budget overspending</option><option value="LowFinancialHealth" selected="@(Model.Type=="LowFinancialHealth")">Low Financial Health</option><option value="BillUpcoming" selected="@(Model.Type=="BillUpcoming")">Upcoming bills</option><option value="BillDueToday" selected="@(Model.Type=="BillDueToday")">Bills due today</option><option value="BillOverdue" selected="@(Model.Type=="BillOverdue")">Overdue bills</option>@foreach (var personalType in IPFMMS.Services.PersonalNotificationService.Types) { <option value="@personalType" selected="@(Model.Type == personalType)">@(personalType switch { "PersonalBudgetOverspending" => "My budget overspending", "PersonalLowHealth" => "My financial health", "DebtReminder" => "Debt reminders", "AutomaticSavings" => "Automatic savings", "MonitoringInvitation" => "Monitoring requests", "MonitoringDisconnected" => "Monitoring disconnections", _ => "Shared invitations" })</option> }</select></div>
        <div><label for="notificationRead" class="form-label">Read status</label><select id="notificationRead" name="read" class="form-select"><option value="all" selected="@(Model.Read=="all")">All</option><option value="unread" selected="@(Model.Read=="unread")">Unread</option><option value="read" selected="@(Model.Read=="read")">Read</option></select></div>
        <button id="notificationFilterButton" class="btn btn-outline-primary" type="submit">Filter</button><a asp-action="Index" id="notificationReset" class="btn btn-outline-secondary">Reset</a>
    </form>
    <div id="notificationFilterError" class="alert alert-warning" role="alert" hidden></div>
    <partial name="_NotificationResults" model="Model" />
    <p class="small text-muted mt-4 mb-0">Bill reminders are checked when the app starts and every five minutes while running, and when notifications refresh. If the app sleeps, reminders can arrive late. Paid, inactive and deleted bill reminders are hidden. Current-month health scores are provisional. Notifications from a link are hidden after disconnection, and new requests need fresh acceptance.</p>
</div>

@section Scripts {<script src="~/js/notification-filters.js" asp-append-version="true"></script>}
