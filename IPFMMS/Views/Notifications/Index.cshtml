@model IPFMMS.ViewModels.NotificationsViewModel
@{ ViewData["Title"]="Notifications"; Layout="_DashboardLayout"; }
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mb-4"><div><h2 class="fw-bold">Notifications</h2><p class="text-muted mb-0">Alerts for people who have accepted your monitoring requests.</p></div><div><span id="notificationPageUnread" class="badge bg-danger px-3 py-2">@Model.UnreadCount unread</span></div></div>
    <p class="small text-muted">Checks use this month's records through today. Budget alerts are sent once per category/month and low-score alerts once per month for each accepted link. Alerts show figures when first detected; the summary shows current figures.</p>
    <form asp-action="Index" method="get" id="notificationFilters" class="d-flex flex-wrap gap-3 align-items-end mb-4">
        <div><label for="notificationType" class="form-label">Alert type</label><select id="notificationType" name="type" class="form-select"><option value="all" selected="@(Model.Type=="all")">All alerts</option><option value="BudgetOverspending" selected="@(Model.Type=="BudgetOverspending")">Budget overspending</option><option value="LowFinancialHealth" selected="@(Model.Type=="LowFinancialHealth")">Low Financial Health</option></select></div>
        <div><label for="notificationRead" class="form-label">Read status</label><select id="notificationRead" name="read" class="form-select"><option value="all" selected="@(Model.Read=="all")">All</option><option value="unread" selected="@(Model.Read=="unread")">Unread</option><option value="read" selected="@(Model.Read=="read")">Read</option></select></div>
        <button id="notificationFilterButton" class="btn btn-outline-primary" type="submit">Filter</button><a asp-action="Index" id="notificationReset" class="btn btn-outline-secondary">Reset</a>
    </form>
    <div id="notificationFilterError" class="alert alert-warning" role="alert" hidden></div>
    <partial name="_NotificationResults" model="Model" />
    <p class="small text-muted mt-4 mb-0">Notifications refresh when you open this page and while the app is visible. Current-month health scores are provisional. Notifications from a link are hidden after disconnection, and new requests need fresh acceptance.</p>
</div>

@section Scripts {<script src="~/js/notification-filters.js" asp-append-version="true"></script>}
