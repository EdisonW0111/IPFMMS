@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    bool isFinanceDashboard =
        currentController == "Dashboard" &&
        currentAction == "Finance";

    bool isTransactions =
    currentController == "Transaction" ||
    currentController == "Income" ||
    currentController == "Expense";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - IPFMMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/dashboard-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/transaction-table.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="dashboard-wrapper sidebar-initializing" id="dashboardWrapper">

        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <div class="sidebar-scroll">
                <div class="sidebar-brand">
                    <a asp-controller="Dashboard"
                        asp-action="Finance"
                        class="brand-link">

                        <img src="~/images/logo.png"
                            alt="IPFMMS"
                            class="sidebar-logo" />

                        <span class="brand-text">IPFMMS</span>
                    </a>
                </div>

                <nav class="sidebar-nav"
                    aria-label="Main navigation">

                    <a asp-controller="Dashboard"
                        asp-action="Finance"
                        class="sidebar-link @(isFinanceDashboard ? "active" : "")"
                        title="Dashboard"
                        aria-current="@(isFinanceDashboard ? "page" : null)">
                        <i class="bi bi-grid-1x2"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>

                    <a asp-controller="Transaction"
                        asp-action="Index"
                        class="sidebar-link @(isTransactions ? "active" : "")"
                        title="Transactions"
                        aria-current="@(isTransactions ? "page" : null)">
                        <i class="bi bi-arrow-left-right"></i>
                        <span class="nav-label">Transactions</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Budgets & Savings">
                        <i class="bi bi-wallet2"></i>
                        <span class="nav-label">Budgets &amp; Savings</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Analytics & Prediction">
                        <i class="bi bi-bar-chart-line"></i>
                        <span class="nav-label">Analytics &amp; Prediction</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Routine Bills">
                        <i class="bi bi-calendar-check"></i>
                        <span class="nav-label">Routine Bills</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Debt Management">
                        <i class="bi bi-credit-card"></i>
                        <span class="nav-label">Debt Management</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Shared Finance">
                        <i class="bi bi-people"></i>
                        <span class="nav-label">Shared Finance</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Parental Monitoring">
                        <i class="bi bi-person-heart"></i>
                        <span class="nav-label">Parental Monitoring</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="nav-label">Notifications</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Settings">
                        <i class="bi bi-gear"></i>
                        <span class="nav-label">Settings</span>
                    </a>

                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="sidebar-bottom">
                    <button type="button"
                        id="sidebarToggle"
                        class="sidebar-toggle"
                        aria-label="Collapse sidebar"
                        aria-expanded="true"
                        aria-controls="dashboardSidebar">

                        <i class="bi bi-layout-sidebar-inset"></i>
                        <span class="nav-label">Collapse Sidebar</span>
                    </button>
                </div>
            </div>
        </aside>

        <div class="dashboard-overlay" id="dashboardOverlay"></div>

        <div class="dashboard-main">

            <header class="dashboard-header">

                <div class="header-left">
                    <button type="button"
                            id="mobileMenuButton"
                            class="mobile-menu-button"
                            aria-label="Open navigation menu"
                            aria-expanded="false"
                            aria-controls="dashboardSidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <h1>@ViewData["Title"]</h1>
                </div>


                <div class="header-user">

                    <div class="profile-dropdown">

                        <button type="button"
                                id="profileDropdownButton"
                                class="profile-button"
                                aria-expanded="false"
                                aria-haspopup="true"
                                aria-controls="profileDropdownMenu">

                            <span class="profile-avatar">
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <span class="profile-name">
                                @User.Identity?.Name
                            </span>

                            <i class="bi bi-chevron-down profile-chevron"></i>
                        </button>

                        <div id="profileDropdownMenu"
                             class="profile-menu"
                             role="group"
                             aria-label="Account options"
                             hidden>

                            <div class="profile-menu-header">
                                <span class="profile-menu-title">
                                    My Account
                                </span>
                            </div>

                            <a asp-controller="Account"
                               asp-action="UpdateProfile"
                               class="profile-menu-item">
                                <i class="bi bi-person-circle"></i>
                                My Profile
                            </a>

                            <a asp-controller="Account"
                               asp-action="ChangePassword"
                               class="profile-menu-item">
                                <i class="bi bi-shield-lock"></i>
                                Change Password
                            </a>

                            <div class="profile-menu-divider"></div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="profile-menu-item profile-logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Logout
                                </button>
                            </form>

                        </div>
                    </div>
                </div>

            </header>

            <main class="dashboard-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/js/dashboard-layout.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>