@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    bool isFinanceDashboard =
        currentController == "Dashboard" &&
        currentAction == "Finance";

    bool isAnalytics = currentController is "Analytics" or "Insights" or "FinancialHealth" or "Prediction";

    bool isBudgets = currentController == "Budget" || currentController == "Savings";

    bool isTransactions =
    currentController == "Transaction" ||
    currentController == "Income" ||
    currentController == "Expense";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - IPFMMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/dashboard-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/transaction-table.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="dashboard-wrapper sidebar-initializing" id="dashboardWrapper">

        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <div class="sidebar-scroll">
                <div class="sidebar-brand">
                    <a asp-controller="Dashboard"
                        asp-action="Index"
                        class="brand-link">

                        <img src="~/images/logo.png"
                            alt="IPFMMS"
                            class="sidebar-logo" />

                        <span class="brand-text">IPFMMS</span>
                    </a>
                </div>

                <nav class="sidebar-nav"
                    aria-label="Main navigation">

                    @if(User.IsInRole("Admin")){
                        <a asp-controller="Dashboard" asp-action="Admin" class="sidebar-link @(currentController == "Dashboard" ? "active" : "")" aria-current="@(currentController == "Dashboard" ? "page" : null)"><i class="bi bi-grid-1x2"></i><span class="nav-label">Admin Dashboard</span></a>
                        <a asp-controller="ParentStudentLinks" asp-action="Index" class="sidebar-link @(currentController == "ParentStudentLinks" ? "active" : "")" aria-current="@(currentController == "ParentStudentLinks" ? "page" : null)"><i class="bi bi-people"></i><span class="nav-label">Relationships</span></a>
                    } else {
                    <a asp-controller="Dashboard"
                        asp-action="Finance"
                        class="sidebar-link @(isFinanceDashboard ? "active" : "")"
                        title="Dashboard"
                        aria-current="@(isFinanceDashboard ? "page" : null)">
                        <i class="bi bi-grid-1x2"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>

                    <a asp-controller="Transaction"
                        asp-action="Index"
                        class="sidebar-link @(isTransactions ? "active" : "")"
                        title="Transactions"
                        aria-current="@(isTransactions ? "page" : null)">
                        <i class="bi bi-arrow-left-right"></i>
                        <span class="nav-label">Transactions</span>
                    </a>

                    <div class="sidebar-nav-group">
                        <button type="button" id="budgetSavingsToggle"
                                class="sidebar-link sidebar-group-toggle @(isBudgets ? "active" : "")"
                                title="Budgets & Savings" aria-label="Budgets and Savings"
                                aria-controls="budgetSavingsSubmenu"
                                aria-expanded="@(isBudgets ? "true" : "false")"
                                data-current-section="@(isBudgets ? "true" : "false")">
                            <i class="bi bi-wallet2" aria-hidden="true"></i>
                            <span class="nav-label">Budgets &amp; Savings</span>
                            <i class="bi bi-chevron-down sidebar-menu-chevron" aria-hidden="true"></i>
                        </button>
                        <div id="budgetSavingsSubmenu" class="sidebar-submenu" hidden="@(!isBudgets)">
                            <a asp-controller="Budget" asp-action="Index"
                               class="sidebar-link @(currentController == "Budget" ? "active" : "")"
                               aria-current="@(currentController == "Budget" ? "page" : null)">
                                <i class="bi bi-wallet2" aria-hidden="true"></i>
                                <span class="nav-label">Budgets</span>
                            </a>
                            <a asp-controller="Savings" asp-action="Index"
                               class="sidebar-link @(currentController == "Savings" ? "active" : "")"
                               aria-current="@(currentController == "Savings" ? "page" : null)">
                                <i class="bi bi-piggy-bank" aria-hidden="true"></i>
                                <span class="nav-label">Savings Goals</span>
                            </a>
                        </div>
                    </div>

                    <div class="sidebar-nav-group">
                        <button type="button" id="analyticsToggle" class="sidebar-link sidebar-group-toggle @(isAnalytics ? "active" : "")"
                                title="Analytics & Prediction" aria-label="Analytics and Prediction" aria-controls="analyticsSubmenu"
                                aria-expanded="@(isAnalytics ? "true" : "false")" data-current-section="@(isAnalytics ? "true" : "false")">
                            <i class="bi bi-bar-chart-line" aria-hidden="true"></i><span class="nav-label">Analytics &amp; Prediction</span>
                            <i class="bi bi-chevron-down sidebar-menu-chevron" aria-hidden="true"></i>
                        </button>
                        <div id="analyticsSubmenu" class="sidebar-submenu" hidden="@(!isAnalytics)">
                            <a asp-controller="Analytics" asp-action="Index" class="sidebar-link @(currentController == "Analytics" ? "active" : "")" aria-current="@(currentController == "Analytics" ? "page" : null)">
                                <i class="bi bi-bar-chart-line" aria-hidden="true"></i><span class="nav-label">Spending Analytics</span></a>
                            <a asp-controller="Insights" asp-action="Index" class="sidebar-link @(currentController == "Insights" ? "active" : "")" aria-current="@(currentController == "Insights" ? "page" : null)">
                                <i class="bi bi-lightbulb" aria-hidden="true"></i><span class="nav-label">Spending Insights</span></a>
                            <a asp-controller="FinancialHealth" asp-action="Index" class="sidebar-link @(currentController == "FinancialHealth" ? "active" : "")" aria-current="@(currentController == "FinancialHealth" ? "page" : null)">
                                <i class="bi bi-heart-pulse" aria-hidden="true"></i><span class="nav-label">Financial Health</span></a>
                            <a asp-controller="Prediction" asp-action="Index" class="sidebar-link @(currentController == "Prediction" ? "active" : "")" aria-current="@(currentController == "Prediction" ? "page" : null)">
                                <i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span class="nav-label">Spending Prediction</span></a>
                        </div>
                    </div>

                    <a asp-controller="RoutineBills" asp-action="Index" class="sidebar-link @(currentController == "RoutineBills" ? "active" : "")"
                        aria-current="@(currentController == "RoutineBills" ? "page" : null)" title="Routine Bills">
                        <i class="bi bi-calendar-check"></i>
                        <span class="nav-label">Routine Bills</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Debt Management">
                        <i class="bi bi-credit-card"></i>
                        <span class="nav-label">Debt Management</span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Shared Finance">
                        <i class="bi bi-people"></i>
                        <span class="nav-label">Shared Finance</span>
                    </a>

                    <a asp-controller="ParentalMonitoring" asp-action="Index" class="sidebar-link @(currentController == "ParentalMonitoring" ? "active" : "")"
                        aria-current="@(currentController == "ParentalMonitoring" ? "page" : null)" title="Parental Monitoring">
                        <i class="bi bi-person-heart"></i>
                        <span class="nav-label">Parental Monitoring</span>
                    </a>

                    <a asp-controller="Notifications" asp-action="Index" class="sidebar-link notifications-link @(currentController == "Notifications" ? "active" : "")"
                        aria-current="@(currentController == "Notifications" ? "page" : null)" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="nav-label">Notifications</span>
                        <span id="notificationUnreadCount" class="badge bg-danger notification-count" data-count-url="@Url.Action("UnreadCount", "Notifications")" hidden></span>
                    </a>

                    <a href="#" class="sidebar-link"
                        title="Settings">
                        <i class="bi bi-gear"></i>
                        <span class="nav-label">Settings</span>
                    </a>

                    }
                </nav>
            </div>
            <div class="sidebar-footer">
                <div class="sidebar-bottom">
                    <button type="button"
                        id="sidebarToggle"
                        class="sidebar-toggle"
                        aria-label="Collapse sidebar"
                        aria-expanded="true"
                        aria-controls="dashboardSidebar">

                        <i class="bi bi-layout-sidebar-inset"></i>
                        <span class="nav-label">Collapse Sidebar</span>
                    </button>
                </div>
            </div>
        </aside>

        <div class="dashboard-overlay" id="dashboardOverlay"></div>

        <div class="dashboard-main">

            <header class="dashboard-header">

                <div class="header-left">
                    <button type="button"
                            id="mobileMenuButton"
                            class="mobile-menu-button"
                            aria-label="Open navigation menu"
                            aria-expanded="false"
                            aria-controls="dashboardSidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <h1>@ViewData["Title"]</h1>
                </div>


                <div class="header-user">

                    <div class="profile-dropdown">

                        <button type="button"
                                id="profileDropdownButton"
                                class="profile-button"
                                aria-expanded="false"
                                aria-haspopup="true"
                                aria-controls="profileDropdownMenu">

                            <span class="profile-avatar">
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <span class="profile-name">
                                @User.Identity?.Name
                            </span>

                            <i class="bi bi-chevron-down profile-chevron"></i>
                        </button>

                        <div id="profileDropdownMenu"
                             class="profile-menu"
                             role="group"
                             aria-label="Account options"
                             hidden>

                            <div class="profile-menu-header">
                                <span class="profile-menu-title">
                                    My Account
                                </span>
                            </div>

                            <a asp-controller="Account"
                               asp-action="UpdateProfile"
                               class="profile-menu-item">
                                <i class="bi bi-person-circle"></i>
                                My Profile
                            </a>

                            <a asp-controller="Account"
                               asp-action="ChangePassword"
                               class="profile-menu-item">
                                <i class="bi bi-shield-lock"></i>
                                Change Password
                            </a>

                            <div class="profile-menu-divider"></div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="profile-menu-item profile-logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Logout
                                </button>
                            </form>

                        </div>
                    </div>
                </div>

            </header>

            <main class="dashboard-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/js/dashboard-layout.js"
            asp-append-version="true"></script>

    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
