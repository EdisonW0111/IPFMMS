@model IPFMMS.ViewModels.AdminUserIndexViewModel
@{ ViewData["Title"] = "User Accounts"; Layout = "_DashboardLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page">
    <div class="admin-heading"><div><h2 class="fw-bold">User Accounts</h2><p class="text-muted">Manage registered accounts and their access to IPFMMS.</p></div><a asp-controller="Dashboard" asp-action="Admin" class="btn btn-outline-secondary">Back to dashboard</a></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4">
        <form asp-action="Index" method="get" data-admin-filters data-results="adminUserResults">
            <div class="admin-filter-grid">
                <div><label for="userSearch" class="form-label">Search accounts</label><input id="userSearch" type="search" name="search" value="@Model.Search" maxlength="100" placeholder="Name, email or account ID" class="form-control" /></div>
                <div><label for="userStatus" class="form-label">Account status</label><select id="userStatus" name="status" class="form-select">@foreach (var status in new[] { "All", "Active", "Inactive", "Pending", "Deleted" }) { <option value="@status" selected="@(Model.Status == status)">@status</option> }</select></div>
                <div><label for="userRole" class="form-label">Role</label><select id="userRole" name="role" class="form-select">@foreach (var role in new[] { "All", "User", "Admin", "Parent" }) { <option value="@role" selected="@(Model.Role == role)">@(role == "Parent" ? "Parent (existing accounts)" : role)</option> }</select></div>
                <div class="admin-filter-actions"><button type="submit" class="btn btn-primary" data-admin-submit>Filter</button><a asp-action="Index" class="btn btn-outline-secondary" data-admin-reset>Reset</a></div>
            </div>
            <div class="alert alert-danger mt-3 mb-0" data-admin-error hidden role="alert">Accounts could not be loaded. Your previous results are still shown. Try filtering again.</div>
        </form>
    </div></div>
    <partial name="_UserResults" model="Model" />
</div>
@section Scripts { <script src="~/js/admin-filters.js" asp-append-version="true"></script> }
