@model IPFMMS.ViewModels.AdminUserDetailsViewModel
@{ ViewData["Title"] = "Account Details"; Layout = "_DashboardLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page">
    <div class="admin-heading"><div><h2 class="fw-bold">Account Details</h2><p class="text-muted">Account information and management history.</p></div><div class="admin-actions"><a asp-action="Index" class="btn btn-outline-secondary">Back to accounts</a>@if (Model.CanEdit) { <a asp-action="Edit" asp-route-id="@Model.User.UserId" class="btn btn-primary">Edit account</a> }@if (Model.CanDelete) { <a asp-action="Delete" asp-route-id="@Model.User.UserId" class="btn btn-outline-danger">Delete account</a> }</div></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (Model.IsSelf) { <div class="alert alert-info">This is your administrator account. You cannot change your own role or account status, or delete your account here.</div> }
    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h3 class="h5 fw-bold mb-3">@Model.User.FullName</h3><dl class="row admin-detail-list mb-0"><dt class="col-sm-3">Account ID</dt><dd class="col-sm-9">@Model.User.UserId</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.User.Email</dd><dt class="col-sm-3">Phone number</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.User.PhoneNumber) ? "Not provided" : Model.User.PhoneNumber)</dd><dt class="col-sm-3">Role</dt><dd class="col-sm-9">@Model.User.Role</dd><dt class="col-sm-3">Account status</dt><dd class="col-sm-9">@Model.User.AccountStatus</dd><dt class="col-sm-3">Registered (MYT)</dt><dd class="col-sm-9">@Model.User.CreatedDate.AddHours(8).ToString("dd MMM yyyy HH:mm")</dd></dl></div></div>
    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h3 class="h5 fw-bold">Record overview</h3><p class="small text-muted">Counts help assess account changes while keeping personal financial details private.</p><div class="admin-record-grid">
        <div class="admin-record-item">Income records<strong>@Model.IncomeCount</strong></div><div class="admin-record-item">Expense records<strong>@Model.ExpenseCount</strong></div><div class="admin-record-item">Budgets<strong>@Model.BudgetCount</strong></div><div class="admin-record-item">Savings goals<strong>@Model.SavingsGoalCount</strong></div><div class="admin-record-item">Debts<strong>@Model.DebtCount</strong></div><div class="admin-record-item">Shared finance groups<strong>@Model.SharedFinanceCount</strong></div><div class="admin-record-item">Monitoring others<strong>@Model.MonitoringAsParentCount</strong></div><div class="admin-record-item">Monitored by others<strong>@Model.MonitoringAsStudentCount</strong></div>
    </div></div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5 fw-bold mb-3">Account management history</h3>
        @if (Model.AuditEntries.Count == 0) { <p class="text-muted mb-0">No account management activity has been recorded.</p> }
        else { <div class="table-responsive"><table class="table align-middle admin-table mb-0"><thead class="table-light"><tr><th>When (MYT)</th><th>Administrator</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach (var activity in Model.AuditEntries) { <tr><td>@activity.CreatedDate.AddHours(8).ToString("dd MMM yyyy HH:mm")</td><td class="admin-user-cell">@activity.AdminName</td><td>@activity.Action</td><td class="admin-audit">@activity.Summary</td></tr> }</tbody></table></div> }
    </div></div>
</div>
