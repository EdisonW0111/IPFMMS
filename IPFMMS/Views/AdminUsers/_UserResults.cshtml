@model IPFMMS.ViewModels.AdminUserIndexViewModel
<div id="adminUserResults" aria-live="polite" class="card border-0 shadow-sm"><div class="card-body p-4">
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><h3 class="h5 fw-bold mb-0">Registered accounts</h3><span class="text-muted">@Model.Count matching account(s)</span></div>
    @if (Model.Users.Count == 0) { <p class="mb-0 text-muted">No accounts match these filters.</p> }
    else {
        <p class="small text-muted d-md-none">Swipe the table to see all columns.</p>
        <div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead class="table-light"><tr><th>Account</th><th>Role</th><th>Status</th><th>Registered (MYT)</th><th>Actions</th></tr></thead><tbody>
        @foreach (var user in Model.Users) {
            var badge = user.AccountStatus == "Active" ? "bg-success" : user.AccountStatus == "Pending" ? "bg-warning text-dark" : user.AccountStatus == "Deleted" ? "bg-danger" : "bg-secondary";
            <tr><td class="admin-user-cell"><strong>@user.FullName</strong><div class="small text-muted">@user.Email</div><div class="small text-muted">@user.UserId</div></td><td>@user.Role</td><td><span class="badge admin-status @badge">@user.AccountStatus</span></td><td>@user.CreatedDate.AddHours(8).ToString("dd MMM yyyy")</td><td><div class="admin-actions"><a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary">Details</a>@if (user.AccountStatus != "Deleted") { <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-secondary">Edit</a> }</div></td></tr>
        }
        </tbody></table></div>
        @if (Model.Pages > 1) {
            <nav class="admin-pagination" aria-label="Account pages"><span class="small text-muted">Page @Model.Page of @Model.Pages</span><div class="admin-actions">
                @if (Model.Page > 1) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-role="@Model.Role" asp-route-page="@(Model.Page - 1)" class="btn btn-sm btn-outline-secondary" data-admin-page>Previous</a> }
                @if (Model.Page < Model.Pages) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-role="@Model.Role" asp-route-page="@(Model.Page + 1)" class="btn btn-sm btn-outline-secondary" data-admin-page>Next</a> }
            </div></nav>
        }
    }
</div></div>
