@model IPFMMS.ViewModels.DeleteBudgetViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Delete Budget";
    Layout = "_DashboardLayout";
}
<div class="container-fluid py-4">
    <div class="row justify-content-center"><div class="col-12 col-lg-8 col-xl-7">
        <h2 class="fw-bold mb-4">Delete Budget</h2>
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">
            <h3 class="h5 fw-bold">@Model.CategoryName — @Model.BudgetMonth.ToString("MMMM yyyy")</h3>
            <p>
                @if (Model.BudgetType == "Percentage")
                {
                    <span>Budget: @Model.BudgetPercentage?.ToString("0.##")% of monthly income</span>
                }
                else
                {
                    <span>Budget: RM @Model.BudgetAmount?.ToString("N2")</span>
                }
            </p>
            <div class="alert alert-warning" role="alert">
                Choose what to delete below. Past months, unrelated budgets and all expense transactions are preserved.
            </div>
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
            <form asp-controller="Budget" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.BudgetId" />
                <fieldset class="mb-4">
                    <legend class="h6">Delete options</legend>
                    <div class="form-check mb-2">
                        <input type="radio" name="scope" value="month" id="deleteMonth" class="form-check-input" checked />
                        <label for="deleteMonth" class="form-check-label">Delete this month only. Keep repetition running.</label>
                    </div>
                    @if (Model.CanDeleteSeries)
                    {
                        <div class="form-check">
                            <input type="radio" name="scope" value="series" id="deleteSeries" class="form-check-input" />
                            <label for="deleteSeries" class="form-check-label">Delete this month and all future budgets in this repeating series (@Model.FutureSeriesCount future saved budget(s)). Stop this series.</label>
                        </div>
                    }
                </fieldset>
                @if (Model.HasUnlinkedCategoryBudgets)
                {
                    <p class="text-muted small">Some budgets in this category have no series link (including older records and independent budgets). They are preserved unless you delete them individually. Series deletion is available only on linked budgets.</p>
                }
                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <a asp-action="Index" asp-route-month="@Model.BudgetMonth.ToString("yyyy-MM", CultureInfo.InvariantCulture)" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">Confirm deletion</button>
                </div>
            </form>
        </div></div>
    </div></div>
</div>
