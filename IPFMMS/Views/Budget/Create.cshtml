@model IPFMMS.ViewModels.CreateBudgetViewModel

@{
    ViewData["Title"] = "Create Budget";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="mb-4">
                <h2 class="fw-bold mb-1">Create Budget</h2>
                <p class="text-muted mb-0">
                    Set a monthly spending limit for an expense category.
                </p>
            </div>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success" role="status">@successMessage</div>
            }

            @if (Model.ExpenseCategories.Count == 0)
            {
                <div class="alert alert-warning" role="alert">
                    No active expense categories are available. Please contact an administrator.
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-controller="Budget" asp-action="Create" method="post" id="createBudgetForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="ExpenseCategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="ExpenseCategoryId" asp-items="Model.ExpenseCategories"
                                    class="form-select" required aria-describedby="categoryError">
                                <option value="">-- Select Expense Category --</option>
                            </select>
                            <span asp-validation-for="ExpenseCategoryId" id="categoryError" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BudgetMonth" class="form-label fw-semibold"></label>
                            <input asp-for="BudgetMonth" type="month" class="form-control"
                                   min="1000-01" max="9998-12" required aria-describedby="monthError" />
                            <span asp-validation-for="BudgetMonth" id="monthError" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BudgetType" class="form-label fw-semibold"></label>
                            <select asp-for="BudgetType" asp-items="Model.BudgetTypes"
                                    class="form-select" required aria-describedby="typeError">
                                <option value="">-- Select Budget Type --</option>
                            </select>
                            <span asp-validation-for="BudgetType" id="typeError" class="text-danger small"></span>
                        </div>

                        <div class="mb-4" id="budgetAmountGroup">
                            <label asp-for="BudgetAmount" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">RM</span>
                                <input asp-for="BudgetAmount" type="number" class="form-control"
                                       min="0.01" max="9999999999.99" step="0.01"
                                       aria-describedby="amountHelp amountError" />
                            </div>
                            <span asp-validation-for="BudgetAmount" id="amountError" class="text-danger small"></span>
                            <div id="amountHelp" class="form-text">Enter a spending limit greater than RM0, with up to two decimal places.</div>
                        </div>

                        <div class="mb-4" id="budgetPercentageGroup">
                            <label asp-for="BudgetPercentage" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="BudgetPercentage" type="number" class="form-control"
                                       min="1" max="100" step="0.01"
                                       aria-describedby="percentageHelp percentageError" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="BudgetPercentage" id="percentageError" class="text-danger small"></span>
                            <div id="percentageHelp" class="form-text">
                                Use 1% to 100% of your income for the selected month.
                                Total percentage allocation across categories cannot exceed 100%.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="4" maxlength="500"
                                      aria-describedby="notesHelp notesError"
                                      placeholder="Enter optional notes..."></textarea>
                            <span asp-validation-for="Notes" id="notesError" class="text-danger small"></span>
                            <div id="notesHelp" class="form-text">Maximum 500 characters.</div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="RepeatMonthly" class="form-check-input"
                                       aria-describedby="repeatHelp repeatError" />
                                <label asp-for="RepeatMonthly" class="form-check-label fw-semibold"></label>
                            </div>
                            <div id="repeatHelp" class="form-text">
                                Repeat these settings from the following month. Unused money is not carried forward.
                                Leaving this unchecked does not change an existing category schedule.
                            </div>
                            <span asp-validation-for="RepeatMonthly" id="repeatError" class="text-danger small"></span>
                        </div>

                        <div class="mb-4" id="repeatUntilGroup">
                            <label asp-for="RepeatUntil" class="form-label fw-semibold"></label>
                            <input asp-for="RepeatUntil" type="month" min="1000-01" max="9998-12"
                                   class="form-control" aria-describedby="repeatUntilHelp repeatUntilError" />
                            <span asp-validation-for="RepeatUntil" id="repeatUntilError" class="text-danger small"></span>
                            <div id="repeatUntilHelp" class="form-text">
                                Include this month, then stop creating new budgets. Leave blank to repeat until turned off.
                                Existing monthly budgets remain unchanged.
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-end gap-2">
                            <a asp-controller="Budget" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn text-white px-4"
                                    style="background-color: #16899a;" disabled="@(Model.ExpenseCategories.Count == 0)">
                                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                                Create Budget
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const budgetType = document.getElementById('BudgetType');
            const amount = document.getElementById('BudgetAmount');
            const percentage = document.getElementById('BudgetPercentage');

            function updateBudgetFields() {
                const isFixed = budgetType.value === 'FixedAmount';
                const isPercentage = budgetType.value === 'Percentage';

                document.getElementById('budgetAmountGroup').hidden = !isFixed;
                document.getElementById('budgetPercentageGroup').hidden = !isPercentage;
                amount.disabled = !isFixed;
                amount.required = isFixed;
                percentage.disabled = !isPercentage;
                percentage.required = isPercentage;
            }

            const repeat = document.getElementById('RepeatMonthly');
            const repeatUntil = document.getElementById('RepeatUntil');
            function updateRepeatFields() {
                document.getElementById('repeatUntilGroup').hidden = !repeat.checked;
                repeatUntil.disabled = !repeat.checked;
                repeatUntil.min = document.getElementById('BudgetMonth').value;
            }
            repeat.addEventListener('change', updateRepeatFields);
            document.getElementById('BudgetMonth').addEventListener('change', updateRepeatFields);
            updateRepeatFields();

            budgetType.addEventListener('change', updateBudgetFields);
            updateBudgetFields();
        })();
    </script>
}
