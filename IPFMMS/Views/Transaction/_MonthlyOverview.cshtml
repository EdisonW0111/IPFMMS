@model IPFMMS.ViewModels.TransactionIndexViewModel

<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    <!-- Financial Summary -->
    <p class="text-muted small mb-3">Monthly totals for <strong>@Model.SelectedMonth.ToString("MMMM yyyy")</strong>.</p>
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Income</div>
                <h3 class="fw-bold text-success mb-0">RM @Model.TotalIncome.ToString("N2")</h3>
            </div></div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Expenses</div>
                <h3 class="fw-bold text-danger mb-0">RM @Model.TotalExpenses.ToString("N2")</h3>
            </div></div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Savings Allocation</div>
                <h3 class="fw-bold mb-0">RM @Model.TotalSavingsAllocated.ToString("N2")</h3>
            </div></div>
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Net</div>
                <h3 class="fw-bold @(Model.NetBalance < 0 ? "text-danger" : "text-success") mb-2">RM @Model.NetBalance.ToString("N2")</h3>
                <p class="text-muted small mb-0">This month's income minus expenses, before savings allocations.</p>
            </div></div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Remaining</div>
                <h3 class="fw-bold @(Model.MonthlyRemaining < 0 ? "text-danger" : "text-success") mb-2">RM @Model.MonthlyRemaining.ToString("N2")</h3>
                <p class="text-muted small mb-0">This month's income minus expenses and savings contributions. Excludes money carried forward.</p>
            </div></div>
        </div>
    </div>

    <!-- Transaction History -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    Recent Transactions This Month
                </h5>

                <div class="d-flex flex-wrap
                align-items-center gap-2">

                    <span class="badge bg-light text-dark border">
                        @Model.Transactions.Count record(s)
                    </span>

                    <a asp-controller="Transaction"
                       asp-action="All"
                       class="btn btn-sm btn-outline-primary">

                        <i class="bi bi-list-ul me-1"></i>
                        View All Transactions
                    </a>

                </div>

            </div>

            <div class="table-responsive transaction-table-wrapper">

                <table class="table table-hover align-middle transaction-table">

                    <thead class="table-light">
                        <tr>
                            <th class="col-date">Date</th>
                            <th class="col-type">Type</th>
                            <th class="col-category">Category</th>
                            <th class="col-description">Description</th>
                            <th class="col-amount text-end">Amount (RM)</th>
                            <th class="col-actions text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Transactions.Any())
                        {
                            foreach (var transaction in Model.Transactions)
                            {
                                bool isIncome =
                                transaction.TransactionType == "Income";

                                <tr>
                                    <td class="transaction-date" data-label="Date">
                                        @transaction.TransactionDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (isIncome)
                                        {
                                            <span class="badge bg-success-subtle
                                                         text-success border border-success-subtle" data-label="Type">
                                                Income
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle
                                                         text-danger border border-danger-subtle" data-label="Type">
                                                Expense
                                            </span>
                                        }
                                    </td>

                                    <td class="transaction-category" data-label="Category">
                                        @transaction.CategoryName
                                    </td>

                                    <td class="transaction-description text-muted" title="@transaction.Description" data-label="Description">
                                        @(string.IsNullOrWhiteSpace(transaction.Description)
                                                                ? "-" : transaction.Description)
                                    </td>

                                    <td class="transaction-amount text-end fw-semibold
                                                       @(isIncome ? "text-success" : "text-danger")" data-label="Amount">
                                        @(isIncome ? "+" : "-")RM
                                        @transaction.Amount.ToString("N2")
                                    </td>

                                    <!-- Actions Column -->
                                    <td class="text-center" data-label="Actions">

                                        <div class="transaction-actions">

                                        @if (isIncome)
                                            {
                                                <!-- Edit Income -->
                                                <a asp-controller="Income"
                                                   asp-action="Edit"
                                                   asp-route-id="@transaction.TransactionId"
                                                   class="btn btn-sm btn-outline-primary transaction-action-btn"
                                                   title="Edit Income">

                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Edit
                                                </a>
                                            }
                                            else
                                            {
                                                <!-- Edit Expense -->
                                                @if(transaction.IsBillPayment)
                                    {
                                        <a asp-controller="RoutineBills" asp-action="History" asp-route-expenseId="@transaction.TransactionId" class="btn btn-sm btn-outline-secondary transaction-action-btn">View payment</a>
                                    }
                                    else
                                    {
<a asp-controller="Expense"
                                                   asp-action="Edit"
                                                   asp-route-id="@transaction.TransactionId"
                                                   class="btn btn-sm btn-outline-primary transaction-action-btn"
                                                   title="Edit Expense">

                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Edit
                                                </a>
                                    }

                                                <!-- View Receipt (only when available) -->
                                                @if (transaction.HasReceipt)
                                                {
                                                    <a asp-controller="Expense"
                                                       asp-action="ViewReceipt"
                                                       asp-route-expenseId="@transaction.TransactionId"
                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       class="btn btn-sm btn-outline-secondary transaction-action-btn"
                                                       title="View Receipt">

                                                        <i class="bi bi-receipt me-1"></i>
                                                        View Receipt
                                                    </a>
                                                }
                                            }

                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center py-5">

                                    <i class="bi bi-receipt fs-1 text-muted"></i>

                                    <h6 class="fw-semibold mt-3">
                                        No transactions for this month
                                    </h6>

                                    <p class="text-muted mb-3">
                                        Choose another month or add an income or expense.
                                    </p>

                                    <a asp-controller="Income"
                                       asp-action="Add"
                                       class="btn text-white"
                                       style="background-color: #16899a;">
                                        Add Income
                                    </a>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
