@model IPFMMS.ViewModels.TransactionIndexViewModel

@{
    ViewData["Title"] = "Transactions";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">

    <!-- Page Heading -->
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Transactions</h2>
            <p class="text-muted mb-0">
                View and manage your income and expenses.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Income"
               asp-action="Add"
               class="btn text-white"
               style="background-color: #16899a;">
                <i class="bi bi-plus-circle me-1"></i>
                Add Income
            </a>

            <a asp-controller="Expense"
               asp-action="Add"
               class="btn btn-outline-danger">

                <i class="bi bi-dash-circle me-1"></i>
                Add Expense
            </a>

        </div>
    </div>

    <form id="transactionMonthForm" asp-controller="Transaction" asp-action="Index" method="get"
          class="d-flex flex-wrap align-items-end gap-2 mb-4">
        <div>
            <label for="transactionMonth" class="form-label fw-semibold">Transaction month</label>
            <input id="transactionMonth" name="month" type="month"
                   value="@Model.SelectedMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)"
                   min="1000-01" max="9998-12" required class="form-control" />
        </div>
        <noscript><button type="submit" class="btn btn-outline-secondary">View month</button></noscript>
    </form>
    <p id="transactionMonthLoading" class="text-muted d-none" role="status">Loading monthly transactions...</p>
    <div id="transactionMonthError" class="alert alert-danger d-none" role="alert">
        Unable to load this month. The displayed results have not changed. Please retry or refresh the page.
        <button type="button" id="retryTransactionMonth" class="btn btn-sm btn-outline-danger ms-2">Try again</button>
    </div>
    <div id="transactionMonthResults" aria-busy="false">
        <partial name="_MonthlyOverview" model="Model" />
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success position-fixed
                    bottom-0 end-0 m-4 shadow"
         role="alert"
         style="z-index: 1050;">
        <i class="bi bi-check-circle me-2"></i>
        @successMessage
    </div>
}
@section Scripts {
    <script src="~/js/transaction-month.js" asp-append-version="true"></script>
}
