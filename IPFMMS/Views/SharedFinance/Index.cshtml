@model IPFMMS.ViewModels.SharedFinanceIndexViewModel
@{ViewData["Title"]="Shared Finance";Layout="_DashboardLayout";}
<div class="container-fluid py-4">
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mb-4"><div><h2 class="fw-bold">Shared Finance</h2><p class="text-muted mb-0">Plan a budget or savings goal with people you invite.</p></div><div class="d-flex gap-2 flex-wrap"><a asp-action="MyEntries" class="btn btn-outline-secondary">My entries &amp; allocations</a><a asp-action="Create" class="btn btn-primary">Create shared finance</a></div></div>
<partial name="_Messages"/>
@if(Model.Invitations.Count>0){<section class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h3 class="h5 fw-bold">Invitations received</h3><p class="small text-muted">Showing the latest @Model.Invitations.Count pending invitation(s), up to 20. Accepting lets you view the group's shared records. Your other personal financial records remain private.</p>
<div class="d-flex flex-column gap-3">@foreach(var invite in Model.Invitations){<div class="border rounded p-3 d-flex flex-wrap justify-content-between gap-3 align-items-center"><div><div class="fw-bold text-break">@invite.Finance?.sharedFinanceName</div><div class="small text-muted text-break">Group creator: @(invite.Finance?.Owner?.FullName??"another user") · Role: @invite.memberRole</div></div><div class="d-flex gap-2"><form asp-action="Decision" method="post"><input type="hidden" name="id" value="@invite.sharedFinanceId"/><input type="hidden" name="version" value="@invite.invitationVersion"/><input type="hidden" name="accept" value="true"/><button class="btn btn-sm btn-primary" type="submit">Accept</button></form><form asp-action="Decision" method="post"><input type="hidden" name="id" value="@invite.sharedFinanceId"/><input type="hidden" name="version" value="@invite.invitationVersion"/><input type="hidden" name="accept" value="false"/><button class="btn btn-sm btn-outline-secondary" type="submit">Reject</button></form></div></div>}</div>
</div></section>}
<section class="card border-0 shadow-sm"><div class="card-body p-4">
<form asp-action="Index" method="get" class="row g-3 align-items-start mb-4" data-shared-filters data-results="sharedGroups">
<div class="col-12 col-lg-5"><label for="sharedSearch" class="form-label">Search</label><input id="sharedSearch" name="search" value="@Model.Search" type="search" maxlength="100" placeholder="Shared finance name" class="form-control"/></div>
<div class="col-12 col-sm-6 col-lg-4"><label for="sharedType" class="form-label">Finance type</label><select id="sharedType" name="type" class="form-select"><option value="all" selected="@(Model.Type=="all")">All types</option><option value="MonthlyBudget" selected="@(Model.Type=="MonthlyBudget")">Monthly budget</option><option value="SavingsGoal" selected="@(Model.Type=="SavingsGoal")">Savings goal</option></select></div>
<div class="col-12 col-sm-6 col-lg-3"><label for="sharedScope" class="form-label">Membership</label><select id="sharedScope" name="scope" class="form-select"><option value="all" selected="@(Model.Scope=="all")">All groups</option><option value="owned" selected="@(Model.Scope=="owned")">Groups I own</option><option value="joined" selected="@(Model.Scope=="joined")">Groups I joined</option></select></div>
<div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary" data-shared-submit>Filter</button><a asp-action="Index" class="btn btn-outline-secondary" data-shared-reset>Reset</a></div></form>
<div data-shared-error class="alert alert-warning" role="alert" hidden>Could not load groups. Your previous results are still displayed. Please try again.</div>
<partial name="_SharedGroups" model="Model"/>
</div></section></div>
@section Scripts{<script src="~/js/shared-finance-filters.js" asp-append-version="true"></script>}
