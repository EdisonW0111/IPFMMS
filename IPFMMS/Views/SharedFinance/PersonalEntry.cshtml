@model IPFMMS.Models.SharedFinanceTransaction
@{ViewData["Title"]="My Shared Finance Entry";Layout="_DashboardLayout";}
<div class="container-fluid py-4" style="max-width:1000px"><div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mb-4"><div><h2 class="fw-bold">My Shared Finance Entry</h2><p class="text-muted text-break mb-0">@Model.Finance?.sharedFinanceName</p></div><a asp-action="MyEntries" class="btn btn-outline-secondary">My entries &amp; allocations</a></div><partial name="_Messages"/>
<div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><p class="small text-muted">This is your own retained shared entry. It is read-only so the group history and your personal transaction stay consistent.</p><dl class="row mb-0"><dt class="col-12 col-md-4">Type</dt><dd class="col-12 col-md-8">@(Model.transactionType=="Withdrawal"?"Allocation released":Model.transactionType)</dd><dt class="col-12 col-md-4">Date</dt><dd class="col-12 col-md-8">@Model.transactionDate.ToString("dd MMM yyyy")</dd><dt class="col-12 col-md-4">Amount</dt><dd class="col-12 col-md-8 fw-bold">RM @Model.amount.ToString("N2")</dd><dt class="col-12 col-md-4">Category</dt><dd class="col-12 col-md-8">@Model.ExpenseCategory?.CategoryName</dd><dt class="col-12 col-md-4">Payment method</dt><dd class="col-12 col-md-8">@Model.paymentMethod</dd><dt class="col-12 col-md-4">Description</dt><dd class="col-12 col-md-8 text-break" style="white-space:pre-wrap">@(Model.description??"—")</dd>@if(Model.expenseId!=null){<dt class="col-12 col-md-4">Expense reference</dt><dd class="col-12 col-md-8">@Model.expenseId</dd>}</dl></div></div></div>
