@model IPFMMS.ViewModels.SharedFinanceDetailsViewModel
@{var finance=Model.Finance;var budget=finance.financeType=="MonthlyBudget";var percent=Model.TargetAmount>0?Math.Clamp(decimal.Round(Model.Saved/Model.TargetAmount*100,1),0,100):0;}
<div id="sharedDetailsResults" data-month="@Model.Month" aria-live="polite">
@if(budget){<div class="row g-3 mb-4"><div class="col-12 col-md-4"><div class="card border h-100"><div class="card-body p-3"><div class="small text-muted">Budget limit · @Model.Month</div><div class="h3 fw-bold text-break mb-0">RM @Model.BudgetAmount.ToString("N2")</div></div></div></div><div class="col-12 col-md-4"><div class="card border h-100"><div class="card-body p-3"><div class="small text-muted">Shared spending · @Model.Month</div><div class="h3 fw-bold text-break mb-0">RM @Model.Spent.ToString("N2")</div></div></div></div><div class="col-12 col-md-4"><div class="card border h-100"><div class="card-body p-3"><div class="small text-muted">Remaining budget</div><div class="h3 fw-bold text-break @(Model.Spent>Model.BudgetAmount?"text-danger":"text-success") mb-0">RM @((Model.BudgetAmount-Model.Spent).ToString("N2"))</div></div></div></div></div><p class="small text-muted">Shared spending counts each member's recorded shared expense once. A budget limit does not reserve money from members' balances.</p>
@if(Model.IsOwner&&finance.status=="Active"){<details class="border rounded p-3 mb-4"><summary class="fw-bold">Set budget for @Model.Month</summary><form asp-action="Budget" method="post" class="row g-3 align-items-end mt-1"><input type="hidden" name="id" value="@finance.sharedFinanceId"/><input type="hidden" name="revision" value="@finance.revision"/><input type="hidden" name="month" value="@Model.Month"/><div class="col-12 col-md-7"><label for="sharedBudgetAmount" class="form-label">Budget limit (RM)</label><div class="input-group"><span class="input-group-text">RM</span><input id="sharedBudgetAmount" name="amount" type="text" inputmode="decimal" value="@Model.BudgetAmount.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required/></div></div><div class="col-12 col-md-5"><button type="submit" class="btn btn-outline-primary">Save monthly budget</button></div></form><p class="small text-muted mt-2 mb-0">This changes only the selected month's plan. Other months keep their saved limits.</p></details>}}
else{<div class="row g-3 mb-3"><div class="col-12 col-md-6 col-xl-3"><div class="card border h-100"><div class="card-body p-3"><div class="small text-muted">Savings target</div><div class="h3 fw-bold text-break mb-0">RM @Model.TargetAmount.ToString("N2")</div></div></div></div><div class="col-12 col-md-6 col-xl-3"><div class="card border h-100"><div class="card-body p-3"><div class="small text-muted">Shared savings allocated</div><div class="h3 fw-bold text-break text-success mb-0">RM @Model.Saved.ToString("N2")</div></div></div></div><div class="col-12 col-md-6 col-xl-3"><div class="card border h-100"><div class="card-body p-3"><div class="small text-muted">My current allocation</div><div class="h3 fw-bold text-break mb-0">RM @Model.MySaved.ToString("N2")</div></div></div></div><div class="col-12 col-md-6 col-xl-3"><div class="card border h-100"><div class="card-body p-3"><div class="small text-muted">Remaining to target</div><div class="h3 fw-bold text-break mb-0">RM @Math.Max(0,Model.TargetAmount-Model.Saved).ToString("N2")</div></div></div></div></div><div class="d-flex justify-content-between small mb-1"><span>Savings progress</span><span>@percent.ToString("0.#")%</span></div><div class="progress mb-3" style="height:8px" role="progressbar" aria-label="Shared savings progress" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-success" style="width:@(percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div><p class="small text-muted">Savings totals are overall allocations after releases. The month and entry-type filters apply to the activity list below. Allocations do not move money between members.</p>}
<p class="small text-muted">@Model.Count matching entry/entries</p>
@if(Model.Transactions.Count==0){<p class="mb-0">No shared entries match this selection.</p>}else{<p class="small text-muted d-md-none">Swipe the table to see all entry details.</p><div class="table-responsive"><table class="table align-middle" style="min-width:1000px"><thead class="table-light"><tr><th>Date</th><th>Member</th><th>Type</th><th>Category</th><th class="text-end">Amount (RM)</th><th>Method</th><th>Description</th></tr></thead><tbody>@foreach(var entry in Model.Transactions){<tr><td class="text-nowrap">@entry.transactionDate.ToString("dd MMM yyyy")</td><td class="text-break">@(entry.User?.FullName??entry.userId)</td><td>@(entry.transactionType=="Withdrawal"?"Allocation released":entry.transactionType)</td><td>@entry.ExpenseCategory?.CategoryName</td><td class="text-end">@entry.amount.ToString("N2")</td><td>@entry.paymentMethod</td><td class="text-break" style="max-width:300px;white-space:pre-wrap">@(entry.description??"—")</td></tr>}</tbody></table></div><p class="small text-muted mb-0">Shared activity is read-only. Each shared expense is recorded in the spending member's personal transactions.</p>
@if(Model.Pages>1){<nav aria-label="Shared activity pages" class="d-flex flex-wrap gap-2 align-items-center mt-3">@if(Model.Page>1){<a asp-action="Details" asp-route-id="@finance.sharedFinanceId" asp-route-month="@Model.Month" asp-route-type="@Model.TransactionType" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Details" asp-route-id="@finance.sharedFinanceId" asp-route-month="@Model.Month" asp-route-type="@Model.TransactionType" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-outline-secondary">Next</a>}</nav>}}
</div>
