@model IPFMMS.ViewModels.SharedFinanceIndexViewModel
<div id="sharedGroups" aria-live="polite"><p class="small text-muted">@Model.Count matching group(s)</p>
@if(Model.Groups.Count==0){<p class="mb-0">No groups match this selection. Create a shared finance arrangement or accept an invitation to get started.</p>}else{
<div class="row g-3">@foreach(var group in Model.Groups){var mine=Model.OwnedGroupIds.Contains(group.sharedFinanceId);var count=Model.MemberCounts.GetValueOrDefault(group.sharedFinanceId);<div class="col-12 col-md-6 col-xl-4"><article class="card border h-100"><div class="card-body p-4 d-flex flex-column"><div class="d-flex flex-wrap gap-2 mb-3"><span class="badge bg-info text-dark">@(group.financeType=="MonthlyBudget"?"Monthly budget":"Savings goal")</span><span class="badge @(mine?"bg-primary":"bg-secondary")">@(mine?"Owner":"Member")</span><span class="badge @(group.status=="Active"?"bg-success":"bg-secondary")">@group.status</span></div><h3 class="h5 fw-bold text-break">@group.sharedFinanceName</h3><p class="small text-muted mb-3">@count member(s)</p>@if(!string.IsNullOrEmpty(group.description)){<p class="text-break">@(group.description.Length>160?group.description[..160]+"…":group.description)</p>}<div class="mt-auto"><a asp-action="Details" asp-route-id="@group.sharedFinanceId" class="btn btn-outline-primary">Open group</a></div></div></article></div>}</div>
@if(Model.Pages>1){<nav aria-label="Shared finance pages" class="d-flex flex-wrap align-items-center gap-2 mt-4">@if(Model.Page>1){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-scope="@Model.Scope" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-scope="@Model.Scope" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-outline-secondary">Next</a>}</nav>}
}</div>
