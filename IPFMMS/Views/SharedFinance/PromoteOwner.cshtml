@model IPFMMS.ViewModels.PromoteSharedOwnerViewModel
@{
    ViewData["Title"] = "Promote to Owner";
    Layout = "_DashboardLayout";
}
<div class="container-fluid py-4" style="max-width:850px">
    <h2 class="fw-bold mb-3">Promote to Owner</h2>
    <p class="text-muted">Share management of this group with an accepted Member.</p>
    <partial name="_Messages" />
    <div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <dl class="row"><dt class="col-sm-3">Shared finance</dt><dd class="col-sm-9 text-break">@Model.GroupName</dd><dt class="col-sm-3">Member</dt><dd class="col-sm-9 text-break">@Model.MemberName</dd><dt class="col-sm-3">New role</dt><dd class="col-sm-9">Owner</dd></dl>
        <div class="alert alert-warning text-break"><strong>@Model.MemberName will have the same group management access as you.</strong> Owners can edit the group's details and plans, invite and remove Members, promote additional Owners, and delete the group from active use.</div>
        <p>You keep your Owner role, so you can both manage the group. Everyone keeps control of their own savings allocation, and personal financial records outside this group remain private.</p>
        <form asp-action="PromoteOwner" asp-route-id="@Model.Id" asp-route-userId="@Model.UserId" method="post">
            <input asp-for="Id" type="hidden" /><input asp-for="UserId" type="hidden" /><input asp-for="Revision" type="hidden" /><input asp-for="InvitationVersion" type="hidden" />
            <div class="border rounded p-3 mb-4"><div class="form-check"><input id="confirmSharedOwner" type="checkbox" class="form-check-input" required /><label for="confirmSharedOwner" class="form-check-label">I want to grant this Member Owner access to the group.</label></div></div>
            <div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Promote to Owner</button></div>
        </form>
    </div></div>
</div>
