@model IPFMMS.ViewModels.SharedPersonalViewModel
@{ViewData["Title"]="My Shared Finance Entries";Layout="_DashboardLayout";}
<div class="container-fluid py-4"><div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mb-4"><div><h2 class="fw-bold">My Entries &amp; Allocations</h2><p class="text-muted mb-0">Your own shared expenses, contributions, and allocation releases.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to shared finance</a></div><partial name="_Messages"/>
<section class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h3 class="h5 fw-bold">My remaining savings allocations</h3><p class="small text-muted">These funds are reserved from your available-to-spend amount. You can release your own remaining allocation even after leaving a group or when the group is inactive or deleted.</p>
@if(Model.SavingsGroups.Count==0){<p class="mb-0">You have no remaining shared savings allocations.</p>}else{<div class="row g-3">@foreach(var group in Model.SavingsGroups){var balance=Model.Balances.GetValueOrDefault(group.sharedFinanceId);<div class="col-12 col-md-6 col-xl-4"><article class="card border h-100"><div class="card-body p-3"><h4 class="h6 fw-bold text-break">@group.sharedFinanceName</h4><p class="small text-muted">Group status: @group.status</p><div class="h4 fw-bold text-break">RM @balance.ToString("N2")</div>@if(balance>0){<a asp-action="Release" asp-route-id="@group.sharedFinanceId" class="btn btn-outline-primary">Release my allocation</a>}</div></article></div>}</div>}
</div></section>
<section class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5 fw-bold">My entry history</h3><p class="small text-muted">@Model.Count recorded entry/entries, including groups you have left and deleted groups. Entries are read-only.</p>
@if(Model.Entries.Count==0){<p class="mb-0">No shared entries recorded yet.</p>}else{<p class="small text-muted d-md-none">Swipe the table to see all details.</p><div class="table-responsive"><table class="table align-middle" style="min-width:950px"><thead class="table-light"><tr><th>Date</th><th>Shared finance</th><th>Type</th><th class="text-end">Amount (RM)</th><th>Method</th><th>Description</th><th>Action</th></tr></thead><tbody>@foreach(var entry in Model.Entries){<tr><td class="text-nowrap">@entry.transactionDate.ToString("dd MMM yyyy")</td><td class="text-break">@(entry.Finance?.sharedFinanceName??entry.sharedFinanceId)</td><td>@(entry.transactionType=="Withdrawal"?"Allocation released":entry.transactionType)</td><td class="text-end">@entry.amount.ToString("N2")</td><td>@entry.paymentMethod</td><td class="text-break" style="max-width:300px;white-space:pre-wrap">@(entry.description??"—")</td><td>@if(entry.expenseId!=null){<a asp-action="PersonalEntry" asp-route-expenseId="@entry.expenseId" class="btn btn-sm btn-outline-secondary text-nowrap">View entry</a>}else{<span class="small text-muted">Recorded allocation</span>}</td></tr>}</tbody></table></div>
@if(Model.Pages>1){<nav aria-label="My shared entry pages" class="d-flex flex-wrap gap-2 align-items-center mt-3">@if(Model.Page>1){<a asp-action="MyEntries" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="MyEntries" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-outline-secondary">Next</a>}</nav>}}
</div></section></div>
