@model IPFMMS.ViewModels.SharedInvitationViewModel
@{ViewData["Title"]="Invite Shared Finance Member";Layout="_DashboardLayout";}
<div class="container-fluid py-4" style="max-width:850px"><h2 class="fw-bold">Invite Member</h2><p class="text-muted text-break">@Model.Finance?.sharedFinanceName</p><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><p>Invite an existing registered user as a member. An email is sent when their invitation email setting is enabled, and they must accept the invitation themselves before accessing this group.</p><form asp-action="Invite" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="mb-4"><label asp-for="Email" class="form-label">Registered email address</label><input asp-for="Email" type="email" maxlength="255" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div><p class="small text-muted">Owners manage the group; Members can record their own shared entries. After accepting, a Member can be promoted to Owner by an existing Owner. Personal records outside this group remain private.</p><div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Send invitation</button></div></form></div></div></div>
@section Scripts{<script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial"/>}
