@model IPFMMS.ViewModels.SharedEntryViewModel
@{var expense=Model.Type=="Expense";var release=Model.Type=="Withdrawal";var title=expense?"Record Shared Expense":release?"Release My Savings Allocation":"Add Shared Savings Contribution";ViewData["Title"]=title;Layout="_DashboardLayout";var today=DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(8)).Date;}
<div class="container-fluid py-4" style="max-width:1000px"><h2 class="fw-bold">@title</h2><p class="text-muted text-break">@Model.Finance?.sharedFinanceName</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
@if(expense){<p>Record an expense you paid for this shared budget. It creates one expense in your own Transactions and counts toward the group's spending.</p>}else if(release){<p>Release part of your own recorded savings allocation back to your available-to-spend amount. This does not create income or transfer money.</p><p class="small text-muted">Only your own remaining allocation can be released. This is available even after you leave a group or the group is deleted.</p>}else{<p>Allocate part of your own available-to-spend amount to this shared goal. The contribution is visible in the group and reserved in your personal savings total.</p><p class="small text-muted">This does not transfer money to the owner or another member. You can release only your own allocation later.</p>}
<form asp-action="Entry" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden"/><input asp-for="SubmissionKey" type="hidden"/><input asp-for="Type" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-4"><label asp-for="Amount" class="form-label">@(release?"Amount to release (RM)":expense?"Expense amount (RM)":"Contribution amount (RM)")</label><div class="input-group"><span class="input-group-text">RM</span><input asp-for="Amount" asp-format="{0:0.00}" type="text" inputmode="decimal" class="form-control"/></div><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="Date" class="form-label">Entry date</label><input asp-for="Date" type="date" min="1000-01-01" max="@today.ToString("yyyy-MM-dd")" class="form-control"/><span asp-validation-for="Date" class="text-danger"></span></div>
@if(expense){<div class="mb-4"><label asp-for="CategoryId" class="form-label">Expense category</label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"><option value="">Select a category</option></select><span asp-validation-for="CategoryId" class="text-danger"></span>@if(Model.Categories.Count==0){<div class="form-text text-danger">No active expense categories are available. Contact the administrator before recording an expense.</div>}</div>}else{<input asp-for="CategoryId" type="hidden"/>}
<div class="mb-4"><label asp-for="PaymentMethod" class="form-label">Payment method</label><select asp-for="PaymentMethod" class="form-select">@foreach(var method in RoutineBillOptions.PaymentMethods){<option value="@method">@method</option>}</select><span asp-validation-for="PaymentMethod" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="Description" class="form-label">Description (optional)</label><textarea asp-for="Description" maxlength="500" rows="3" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<p class="small text-muted">Entries are retained as read-only history. Check the amount and date before confirming.@if(expense){<span> Do not add the same expense separately in Transactions.</span>}</p>
<div class="d-flex flex-wrap gap-2 justify-content-end">@if(release){<a asp-action="MyEntries" class="btn btn-outline-secondary">Cancel</a>}else{<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>}<button type="submit" class="btn btn-primary" disabled="@(expense&&Model.Categories.Count==0)">@(expense?"Record expense":release?"Release allocation":"Record contribution")</button></div>
</form></div></div></div>
@section Scripts{<script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial"/>}
