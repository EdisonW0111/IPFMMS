@model IPFMMS.ViewModels.SharedFinanceFormViewModel
@{var edit=!string.IsNullOrEmpty(Model.Id);ViewData["Title"]=edit?"Edit Shared Finance":"Create Shared Finance";Layout="_DashboardLayout";}
<div class="container-fluid py-4" style="max-width:1000px"><h2 class="fw-bold">@ViewData["Title"]</h2><p class="text-muted">Choose a shared monthly budget or savings goal and invite registered users.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><form data-shared-finance-form asp-action="@(edit?"Edit":"Create")" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" maxlength="100" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="FinanceType" class="form-label">Finance type</label>@if(edit){<input asp-for="FinanceType" type="hidden"/><div class="form-control bg-light">@(Model.FinanceType=="MonthlyBudget"?"Monthly budget":"Savings goal")</div><div class="form-text">The finance type stays the same after creation.</div>}else{<select asp-for="FinanceType" class="form-select"><option value="MonthlyBudget">Monthly budget</option><option value="SavingsGoal">Savings goal</option></select>}<span asp-validation-for="FinanceType" class="text-danger"></span></div>
<div class="row g-3"><div data-shared-amount-group class="col-12 @(Model.FinanceType=="MonthlyBudget"?"col-md-6":"") mb-4"><label asp-for="Amount" class="form-label">@(Model.FinanceType=="MonthlyBudget"?"Budget limit (RM)":"Savings target (RM)")</label><div class="input-group"><span class="input-group-text">RM</span><input asp-for="Amount" asp-format="{0:0.00}" type="text" inputmode="decimal" class="form-control"/></div><span asp-validation-for="Amount" class="text-danger"></span></div><div data-shared-budget-month class="col-12 col-md-6 mb-4" hidden="@(Model.FinanceType=="SavingsGoal")"><label asp-for="Month" class="form-label">Budget month</label><input asp-for="Month" disabled="@(Model.FinanceType=="SavingsGoal")" type="month" min="1000-01" max="9998-12" class="form-control"/><span asp-validation-for="Month" class="text-danger"></span><div class="form-text">Used for monthly budgets. Savings goals use an overall target.</div></div></div>
<div class="mb-4"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" maxlength="500" rows="3" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
@if(!edit){<div class="mb-4"><label asp-for="InviteEmails" class="form-label"></label><textarea asp-for="InviteEmails" maxlength="3000" rows="4" class="form-control" placeholder="One registered email address per line"></textarea><span asp-validation-for="InviteEmails" class="text-danger"></span><div class="form-text">Invite at least one other registered user, up to ten. Invited people must accept before they can access the group. You start as Owner and can promote an accepted Member to Owner so you can both manage the group.</div></div>}else{<div class="mb-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option value="Active">Active</option><option value="Inactive">Inactive</option></select><div class="form-text">Inactive groups retain their history and stop new spending or contributions.</div></div>}
<p class="small text-muted">Creating a group does not move money or create an income or expense. Savings contributions allocate your own available funds; shared spending creates an expense for the person recording it.</p><div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-action="@(edit?"Details":"Index")" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">@(edit?"Save changes":"Create shared finance")</button></div>
</form></div></div></div>
@section Scripts{<script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial"/><script src="~/js/shared-finance-filters.js" asp-append-version="true"></script>}
