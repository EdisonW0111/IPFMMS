@model IPFMMS.ViewModels.AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; Layout = "_DashboardLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page">
    <div class="admin-heading"><div><h2 class="fw-bold">Admin Dashboard</h2><p class="text-muted">System overview and administrative management.</p></div><span class="small text-muted">As of @Model.AsOfUtc.AddHours(8).ToString("dd MMM yyyy HH:mm") MYT</span></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="admin-stat-grid mb-4">
        <div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-2">Registered accounts</p><div class="admin-stat-number">@Model.TotalAccounts</div><div class="small text-muted mt-2">@Model.AdminAccounts administrator(s)</div></div></div>
        <div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-2">Active users</p><div class="admin-stat-number">@Model.ActiveUsers</div><div class="small text-muted mt-2">@Model.PendingAccounts pending verification</div></div></div>
        <div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-2">Active monitoring links</p><div class="admin-stat-number">@Model.ActiveRelationships</div><div class="small text-muted mt-2">@Model.PendingRelationships awaiting consent</div></div></div>
        <div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-2">Active categories</p><div class="admin-stat-number">@(Model.ActiveIncomeCategories + Model.ActiveExpenseCategories)</div><div class="small text-muted mt-2">@Model.ActiveIncomeCategories income · @Model.ActiveExpenseCategories expense</div></div></div>
    </div>
    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h3 class="h5 fw-bold mb-3">Management</h3><div class="admin-section-links"><a asp-controller="AdminUsers" asp-action="Index" class="btn btn-primary"><i class="bi bi-person-gear me-1" aria-hidden="true"></i>User accounts</a><a asp-controller="ParentStudentLinks" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-people me-1" aria-hidden="true"></i>Monitoring relationships</a><a asp-controller="AdminCategories" asp-action="Index" asp-route-kind="Income" class="btn btn-outline-primary">Income categories</a><a asp-controller="AdminCategories" asp-action="Index" asp-route-kind="Expense" class="btn btn-outline-primary">Expense categories</a></div><p class="small text-muted mt-3 mb-0">@Model.InactiveAccounts inactive account(s) · @Model.DeletedAccounts deleted account(s) · @Model.TotalRelationships total relationship(s) · @Model.IncomeCategories income categories · @Model.ExpenseCategories expense categories</p></div></div>
    <div class="row g-4 mb-4"><div class="col-xl-7"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h3 class="h5 fw-bold mb-3">System records</h3><div class="admin-record-grid"><div class="admin-record-item">Income records<strong>@Model.IncomeRecords</strong></div><div class="admin-record-item">Expense records<strong>@Model.ExpenseRecords</strong></div><div class="admin-record-item">Budgets<strong>@Model.BudgetRecords</strong></div><div class="admin-record-item">Savings goals<strong>@Model.SavingsGoals</strong></div><div class="admin-record-item">Debts<strong>@Model.DebtRecords</strong></div><div class="admin-record-item">Shared groups<strong>@Model.SharedGroups</strong></div></div></div></div></div>
    <div class="col-xl-5"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h3 class="h5 fw-bold mb-3">Recently registered accounts</h3>@if (Model.RecentAccounts.Count == 0) { <p class="text-muted mb-0">No registered accounts to show.</p> } else { <ul class="list-unstyled mb-0">@foreach (var user in Model.RecentAccounts) { <li class="d-flex flex-wrap justify-content-between gap-2 border-bottom py-2"><div class="admin-user-cell"><a asp-controller="AdminUsers" asp-action="Details" asp-route-id="@user.UserId">@user.FullName</a><div class="small text-muted">@user.CreatedDate.AddHours(8).ToString("dd MMM yyyy")</div></div><span class="small text-muted">@user.AccountStatus</span></li> }</ul> }</div></div></div></div>
    <div class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5 fw-bold">Recent management activity</h3><p class="small text-muted">Account, category and relationship changes recorded by administrators.</p>
        @if (Model.RecentActivity.Count == 0) { <p class="text-muted mb-0">No administrative changes have been recorded yet.</p> }
        else { <div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead class="table-light"><tr><th>When (MYT)</th><th>Administrator</th><th>Area</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach (var activity in Model.RecentActivity) { <tr><td>@activity.CreatedDate.AddHours(8).ToString("dd MMM yyyy HH:mm")</td><td class="admin-user-cell">@activity.AdminName</td><td>@activity.EntityType<div class="small text-muted">@activity.EntityId</div></td><td>@activity.Action</td><td class="admin-audit">@activity.Summary</td></tr> }</tbody></table></div> }
    </div></div>
</div>
