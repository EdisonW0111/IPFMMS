@model IPFMMS.ViewModels.FinancialDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Financial Dashboard";
    Layout = "_DashboardLayout";
    string monthKey = Model.CurrentMonth.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    var budgetPreview = Model.BudgetSummary.Budgets
        .OrderByDescending(b => (b.Status is "Overspent" or "Limit reached") ? 2 : b.Status == "Warning" ? 1 : 0)
        .ThenByDescending(b => b.Utilization ?? 0m).Take(3).ToList();
    var savingsPreview = Model.SavingsSummary.Goals
        .OrderBy(g => g.IsCompleted ? 1 : 0).ThenBy(g => g.TargetDate).Take(3).ToList();
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Financial Overview</h2>
            <p class="text-muted mb-0">Your recorded finances, as of @Model.AsOfDate.ToString("dd MMM yyyy").</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Income" asp-action="Add" class="btn text-white" style="background-color: #16899a;">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i> Add Income
            </a>
            <a asp-controller="Expense" asp-action="Add" class="btn btn-outline-danger">
                <i class="bi bi-dash-circle me-1" aria-hidden="true"></i> Add Expense
            </a>
        </div>
    </div>

    @if (Model.FinancialHealth is { } health)
    {
        <section aria-labelledby="healthPreviewHeading" class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div><h3 id="healthPreviewHeading" class="h5 fw-bold">Financial health - @Model.CurrentMonth.ToString("MMMM yyyy")</h3>
                    @if (health.Overall.HasValue)
                    {
                        <div class="h3 fw-bold mb-1">@health.Overall.Value.ToString("0.##") / 100 <span class="h6"><partial name="_FinancialHealthRating" model="health.Rating" /></span></div>
                        <p class="small text-muted mb-0">Provisional score based on your recorded savings, budgets and three completed spending months.</p>
                    }
                    else
                    {
                        <p class="mb-1">Not enough data for an overall score.</p>
                        <p class="small text-muted mb-0">View the breakdown to see which records are needed.</p>
                    }
                </div>
                <a asp-controller="FinancialHealth" asp-action="Index" asp-route-month="@monthKey" class="btn btn-outline-primary">View score breakdown</a>
            </div>
        </section>
    }

    <section aria-labelledby="overallHeading" class="mb-4">
        <h3 id="overallHeading" class="h5 fw-bold mb-3">Overall balances</h3>
        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-white" style="background-color: #153f52;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-wallet2" aria-hidden="true"></i>
                            <span>Available to Spend</span>
                        </div>
                        <div class="h2 fw-bold mb-2">RM @Model.AvailableToSpend.ToString("N2")</div>
                        <p class="small text-white-50 mb-0">All recorded income minus expenses and money allocated to savings.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="text-muted mb-3">Overall Net Balance</div>
                        <div class="h2 fw-bold @(Model.OverallNetBalance < 0 ? "text-danger" : "text-success") mb-2">RM @Model.OverallNetBalance.ToString("N2")</div>
                        <p class="text-muted small mb-0">All recorded income minus expenses, before savings allocations.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mt-1 px-1">
            <div class="col-12 col-sm-4"><span class="text-muted small">All-time income</span><div class="fw-semibold">RM @Model.TotalIncome.ToString("N2")</div></div>
            <div class="col-12 col-sm-4"><span class="text-muted small">All-time expenses</span><div class="fw-semibold">RM @Model.TotalExpenses.ToString("N2")</div></div>
            <div class="col-12 col-sm-4"><span class="text-muted small">Allocated to savings</span><div class="fw-semibold">RM @Model.TotalSavingsAllocated.ToString("N2")</div></div>
        </div>
    </section>

    <section aria-labelledby="monthHeading" class="mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h3 id="monthHeading" class="h5 fw-bold mb-0">@Model.CurrentMonth.ToString("MMMM yyyy") at a glance</h3>
            <a asp-controller="Transaction" asp-action="Index" asp-route-month="@monthKey" class="btn btn-sm btn-outline-secondary">View Transactions</a>
        </div>
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Income</div>
                <div class="h4 fw-bold text-success mb-0">RM @Model.MonthlyIncome.ToString("N2")</div>
            </div></div></div>
            <div class="col-12 col-sm-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Expenses</div>
                <div class="h4 fw-bold text-danger mb-0">RM @Model.MonthlyExpenses.ToString("N2")</div>
            </div></div></div>
            <div class="col-12 col-sm-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Savings Allocation</div>
                <div class="h4 fw-bold mb-0">RM @Model.MonthlySavingsAllocated.ToString("N2")</div>
            </div></div></div>
            <div class="col-12 col-sm-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4">
                <div class="text-muted small mb-2">Monthly Remaining</div>
                <div class="h4 fw-bold @(Model.MonthlyRemaining < 0 ? "text-danger" : "text-success") mb-0">RM @Model.MonthlyRemaining.ToString("N2")</div>
            </div></div></div>
        </div>
        <p class="text-muted small mt-3 mb-0">Monthly Remaining excludes money carried forward. Available to Spend above includes all recorded months.</p>
    </section>

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <section class="card border-0 shadow-sm rounded-4 h-100" aria-labelledby="budgetsHeading">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h3 id="budgetsHeading" class="h5 fw-bold mb-1">Budget Check-in</h3>
                            <span class="text-muted small">@Model.CurrentMonth.ToString("MMMM yyyy")</span>
                        </div>
                        <a asp-controller="Budget" asp-action="Index" asp-route-month="@monthKey" class="btn btn-sm btn-outline-secondary">View Budgets</a>
                    </div>
                    @if (Model.BudgetSummary.Budgets.Count == 0)
                    {
                        <div class="py-4 text-center">
                            <i class="bi bi-wallet2 fs-2 text-muted" aria-hidden="true"></i>
                            <h4 class="h6 fw-semibold mt-3">No budgets saved for this month</h4>
                            <p class="text-muted small mb-0">Open Budgets to set up this month and review your repeat settings.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-6"><div class="text-muted small">Budget limit</div><div class="fw-bold">RM @Model.BudgetSummary.TotalBudget.ToString("N2")</div></div>
                            <div class="col-6"><div class="text-muted small">Spent in budgeted categories</div><div class="fw-bold">RM @Model.BudgetSummary.BudgetedSpending.ToString("N2")</div></div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="badge bg-success-subtle text-success">@Model.HealthyBudgetCount healthy</span>
                            <span class="badge bg-warning-subtle text-dark">@Model.WarningBudgetCount warning</span>
                            <span class="badge bg-danger-subtle text-danger">@Model.ReachedBudgetCount at/over limit</span>
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach (var budget in budgetPreview)
                            {
                                string color = budget.Status switch
                                {
                                    "Overspent" or "Limit reached" => "danger",
                                    "Warning" => "warning",
                                    "Healthy" => "success",
                                    _ => "secondary"
                                };
                                string width = budget.Progress.ToString("0.##", CultureInfo.InvariantCulture);
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                        <span class="fw-semibold text-break">@budget.CategoryName</span>
                                        <span class="badge bg-@color @(color == "warning" ? "text-dark" : "text-white")">@budget.Status</span>
                                    </div>
                                    <div class="progress mb-2" role="progressbar" aria-label="@budget.CategoryName budget usage" aria-valuenow="@width" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar bg-@color" style="width: @(width)%;"></div>
                                    </div>
                                    <div class="text-muted small">RM @budget.AmountSpent.ToString("N2") spent of RM @budget.BudgetLimit.ToString("N2")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-6">
            <section class="card border-0 shadow-sm rounded-4 h-100" aria-labelledby="savingsHeading">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h3 id="savingsHeading" class="h5 fw-bold mb-1">Savings Goals</h3>
                            <span class="text-muted small">@Model.SavingsSummary.ActiveGoals active · @Model.SavingsSummary.CompletedGoals completed</span>
                        </div>
                        <a asp-controller="Savings" asp-action="Index" class="btn btn-sm btn-outline-secondary">View Goals</a>
                    </div>
                    @if (Model.SavingsSummary.Goals.Count == 0)
                    {
                        <div class="py-4 text-center">
                            <i class="bi bi-piggy-bank fs-2 text-muted" aria-hidden="true"></i>
                            <h4 class="h6 fw-semibold mt-3">Give your savings a goal</h4>
                            <p class="text-muted small">Choose a target and track your contributions toward it.</p>
                            <a asp-controller="Savings" asp-action="Create" class="btn btn-sm text-white" style="background-color: #16899a;">Create Savings Goal</a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-6"><div class="text-muted small">Saved toward goals</div><div class="fw-bold text-success">RM @Model.SavingsSummary.TotalSaved.ToString("N2")</div></div>
                            <div class="col-6"><div class="text-muted small">Remaining to reach goals</div><div class="fw-bold">RM @Model.SavingsSummary.TotalRemaining.ToString("N2")</div></div>
                        </div>
                        @if (Model.OverdueSavingsGoalCount > 0)
                        {
                            <div class="small text-muted mb-2">@Model.OverdueSavingsGoalCount goal(s) past their target date. You can continue contributing.</div>
                        }
                        <div class="list-group list-group-flush">
                            @foreach (var goal in savingsPreview)
                            {
                                string color = goal.DisplayStatus == "Completed" ? "success" : goal.DisplayStatus == "Overdue" ? "warning" : "info";
                                string width = goal.ProgressPercent.ToString("0.##", CultureInfo.InvariantCulture);
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                        <span class="fw-semibold text-break">@goal.GoalName</span>
                                        <span class="badge bg-@color @(color == "success" ? "text-white" : "text-dark")">@goal.DisplayStatus</span>
                                    </div>
                                    <div class="progress mb-2" role="progressbar" aria-label="@goal.GoalName savings progress" aria-valuenow="@width" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="background-color: #16899a; width: @(width)%;"></div>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-between gap-1 text-muted small">
                                        <span>RM @goal.TotalSaved.ToString("N2") of RM @goal.TargetAmount.ToString("N2")</span>
                                        <span>Target @goal.TargetDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
    <div class="row g-4 mt-1">
        <div class="col-12 col-xl-5">
            <section class="card border-0 shadow-sm rounded-4 h-100" aria-labelledby="dashboardBillsHeading">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h3 id="dashboardBillsHeading" class="h5 fw-bold mb-1">Upcoming bills</h3><span class="small text-muted">Next 30 days · @Model.UpcomingBillCount unpaid</span></div><a asp-controller="RoutineBills" asp-action="Index" class="btn btn-sm btn-outline-secondary">View all bills</a></div>
                    @if(Model.OverdueBillCount>0){
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"><span class="fw-semibold text-danger">@Model.OverdueBillCount overdue bill(s)</span><a asp-controller="RoutineBills" asp-action="Index" asp-route-status="Overdue" class="small">Review overdue bills</a></div>
                        <p class="small text-muted">Showing the oldest @Model.OverdueBills.Count overdue item(s).</p>
                        @foreach(var bill in Model.OverdueBills){<div class="border rounded p-3 mb-2"><div class="d-flex justify-content-between flex-wrap gap-2"><a asp-controller="RoutineBills" asp-action="Index" asp-route-search="@bill.Name" class="fw-semibold text-break">@bill.Name</a><span class="fw-bold text-nowrap">RM @bill.Amount.ToString("N2")</span></div><div class="small text-muted mt-1 text-break">@bill.Category · Due @bill.DueDate.ToString("dd MMM yyyy")</div><div class="d-flex flex-wrap gap-2 align-items-center mt-2"><span class="badge bg-danger">Overdue</span><a asp-controller="RoutineBills" asp-action="Pay" asp-route-id="@bill.BillId" class="btn btn-sm btn-outline-primary">Mark as paid</a></div></div>}
                        <hr class="my-3"/>
                    }
                    @if(Model.UpcomingBills.Count==0){<p class="text-muted small mb-0">No unpaid bills are due in the next 30 days.</p>}else{
                        foreach(var bill in Model.UpcomingBills){var dueToday=bill.DueDate==Model.AsOfDate;<div class="border rounded p-3 mb-2"><div class="d-flex justify-content-between flex-wrap gap-2"><a asp-controller="RoutineBills" asp-action="Index" asp-route-search="@bill.Name" class="fw-semibold text-break">@bill.Name</a><span class="fw-bold text-nowrap">RM @bill.Amount.ToString("N2")</span></div><div class="small text-muted mt-1 text-break">@bill.Category · Due @bill.DueDate.ToString("dd MMM yyyy")</div><div class="d-flex flex-wrap gap-2 align-items-center mt-2"><span class="badge @(dueToday?"bg-warning text-dark":"bg-info text-dark")">@(dueToday?"Due today":"Upcoming")</span>@if(bill.DueDate<Model.CurrentMonth.AddMonths(1)){<a asp-controller="RoutineBills" asp-action="Pay" asp-route-id="@bill.BillId" class="btn btn-sm btn-outline-primary">Mark as paid</a>}</div></div>}
                        <p class="small text-muted mb-0 mt-2">Showing the next @Model.UpcomingBills.Count of @Model.UpcomingBillCount due item(s). Paid occurrences, inactive schedules and deleted schedules are excluded.</p>
                    }
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-7">
            <section class="card border-0 shadow-sm rounded-4 h-100" aria-labelledby="dashboardActivityHeading">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h3 id="dashboardActivityHeading" class="h5 fw-bold mb-1">Recent financial activity</h3><span class="small text-muted">Latest 10 records through today</span></div><a asp-controller="Transaction" asp-action="All" class="btn btn-sm btn-outline-secondary">View transactions</a></div>
                    <p class="small text-muted">Income, spending and savings allocations are shown separately. Bill, debt and shared payments already recorded as expenses appear once.</p>
                    @if(Model.RecentActivities.Count==0){<p class="text-muted mb-0">No financial activity recorded yet.</p>}else{
                        <p class="small text-muted d-md-none">Swipe the table to see all activity details.</p>
                        <div class="table-responsive"><table class="table align-middle mb-0" style="min-width:560px"><thead class="table-light"><tr><th>Date</th><th>Activity</th><th class="text-end">Amount (RM)</th><th>Action</th></tr></thead><tbody>
                        @foreach(var activity in Model.RecentActivities){<tr><td class="text-nowrap">@activity.Date.ToString("dd MMM yyyy")</td><td><div class="small @(activity.Type=="Income"?"text-success":activity.Type=="Expense"?"text-danger":"text-muted")">@activity.Label</div><div class="fw-semibold text-break" style="max-width:300px">@activity.Title</div>@if(!string.IsNullOrEmpty(activity.Description)){<div class="small text-muted text-break" style="max-width:300px">@(activity.Description.Length>100?activity.Description[..100]+"…":activity.Description)</div>}</td><td class="text-end text-nowrap @(activity.Type=="Income"||activity.Type=="SharedRelease"?"text-success":activity.Type=="Expense"?"text-danger":"")">@activity.Prefix@activity.Amount.ToString("N2")</td><td><a asp-controller="@activity.Controller" asp-action="@activity.Action" asp-route-id="@activity.RouteId" asp-route-expenseId="@activity.ExpenseId" class="btn btn-sm btn-outline-secondary">View</a></td></tr>}
                        </tbody></table></div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
