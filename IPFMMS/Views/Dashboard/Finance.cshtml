@{
    ViewData["Title"] = "Financial Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row g-4">

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4">
            <div class="text-muted small">Current Balance</div>
            <h3 class="mt-2">RM 0.00</h3>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4">
            <div class="text-muted small">Monthly Income</div>
            <h3 class="mt-2">RM 0.00</h3>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4">
            <div class="text-muted small">Monthly Expenses</div>
            <h3 class="mt-2">RM 0.00</h3>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4">
            <div class="text-muted small">Financial Health Score</div>
            <h3 class="mt-2">—</h3>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm mt-4 p-4">
    <h5>Spending Overview</h5>
    <p class="text-muted mb-0">
        Your spending analytics will appear here
        once you start recording transactions.
    </p>
</div>