@model IPFMMS.ViewModels.ParentStudentLinkIndexViewModel
@{ ViewData["Title"] = "Monitoring Relationships"; Layout = "_DashboardLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page">
    <div class="admin-heading"><div><h2 class="fw-bold">Monitoring Relationships</h2><p class="text-muted">Manage monitoring requests and links between existing user accounts.</p></div><a asp-action="Create" class="btn btn-primary">Create linking request</a></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["WarningMessage"] is string warning) { <div class="alert alert-warning" role="alert">@warning</div> }
    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><form asp-action="Index" method="get" data-admin-filters data-results="adminRelationshipResults"><div class="admin-filter-grid admin-two-filters"><div><label for="relationshipSearch" class="form-label">Search relationships</label><input id="relationshipSearch" type="search" name="search" value="@Model.Search" maxlength="100" class="form-control" placeholder="Name or email" /></div><div><label for="relationshipStatus" class="form-label">Status</label><select id="relationshipStatus" name="status" class="form-select">@foreach (var status in new[] { "All", "Pending", "Active", "Inactive", "Rejected", "Cancelled" }) { <option value="@status" selected="@(Model.Status == status)">@status</option> }</select></div><div class="admin-filter-actions"><button type="submit" class="btn btn-primary" data-admin-submit>Filter</button><a asp-action="Index" class="btn btn-outline-secondary" data-admin-reset>Reset</a></div></div><div class="alert alert-danger mt-3 mb-0" data-admin-error hidden role="alert">Relationships could not be loaded. Your previous results are still shown. Try filtering again.</div></form></div></div>
    <partial name="_RelationshipResults" model="Model" />
</div>
@section Scripts { <script src="~/js/admin-filters.js" asp-append-version="true"></script> }
