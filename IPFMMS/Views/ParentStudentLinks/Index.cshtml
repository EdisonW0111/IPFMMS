@model IPFMMS.ViewModels.ParentStudentLinkIndexViewModel
@{ ViewData["Title"] = "Parent–Student Relationships"; Layout = "_DashboardLayout"; }
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h2 class="fw-bold">Parent–Student Relationships</h2><p class="text-muted mb-0">Manage which parent accounts are linked to which students.</p></div><div><a asp-action="Create" class="btn btn-primary">Link accounts</a></div></div>
    @if(TempData["SuccessMessage"] is string success){<div class="alert alert-success" role="status">@success</div>}
    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-3 mb-4">
        <div class="flex-grow-1"><label for="relationshipSearch" class="form-label">Name or email</label><input id="relationshipSearch" type="search" name="search" value="@Model.Search" maxlength="100" class="form-control" /></div>
        <div><label for="relationshipStatus" class="form-label">Status</label><select id="relationshipStatus" name="status" class="form-select"><option selected="@(Model.Status == "All")">All</option><option selected="@(Model.Status == "Active")">Active</option><option selected="@(Model.Status == "Inactive")">Inactive</option></select></div>
        <button type="submit" class="btn btn-outline-primary">Filter</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </form>
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
        <p class="text-muted">@Model.Count relationship(s)</p>
        @if(Model.Links.Count == 0){<p class="mb-0">No matching relationships found.</p>}
        else {
            <p class="small text-muted d-md-none">Swipe the table to see all columns.</p>
            <div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Parent</th><th>Student</th><th>Status</th><th>Linked date (MYT)</th><th>Action</th></tr></thead><tbody>
            @foreach(var link in Model.Links){<tr><td><strong>@link.ParentName</strong><div class="small text-muted">@link.ParentEmail</div></td><td><strong>@link.StudentName</strong><div class="small text-muted">@link.StudentEmail</div></td><td><span class="badge @(link.Status == "Active" ? "bg-success" : "bg-secondary")">@link.Status</span></td><td>@DateTime.SpecifyKind(link.LinkedDate,DateTimeKind.Utc).AddHours(8).ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="Manage" asp-route-id="@link.LinkId" class="btn btn-sm btn-outline-primary">Manage</a></td></tr>}
            </tbody></table></div>
            @if(Model.Pages > 1){<nav aria-label="Relationship pages" class="d-flex gap-2 align-items-center mt-3">
                @if(Model.Page > 1){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-outline-secondary">Previous</a>}
                <span>Page @Model.Page of @Model.Pages</span>
                @if(Model.Page < Model.Pages){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-outline-secondary">Next</a>}
            </nav>}
        }
    </div></div>
</div>
