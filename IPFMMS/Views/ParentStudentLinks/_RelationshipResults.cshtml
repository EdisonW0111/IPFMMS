@model IPFMMS.ViewModels.ParentStudentLinkIndexViewModel
<div id="adminRelationshipResults" aria-live="polite" class="card border-0 shadow-sm"><div class="card-body p-4"><div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><h3 class="h5 fw-bold mb-0">Requests and relationships</h3><span class="text-muted">@Model.Count matching relationship(s)</span></div>
    @if (Model.Links.Count == 0) { <p class="text-muted mb-0">No relationships match these filters.</p> }
    else {
        <p class="small text-muted d-md-none">Swipe the table to see all columns.</p><div class="table-responsive"><table class="table admin-table align-middle mb-0"><thead class="table-light"><tr><th>Monitoring account</th><th>Monitored account</th><th>Status</th><th>Monitoring access</th><th>Requested (MYT)</th><th>Action</th></tr></thead><tbody>
        @foreach (var link in Model.Links) {
            var badge = link.Status == "Active" ? "bg-success" : link.Status == "Pending" ? "bg-warning text-dark" : link.Status == "Rejected" ? "bg-danger" : "bg-secondary";
            <tr><td class="admin-user-cell"><strong>@link.ParentName</strong><div class="small text-muted">@link.ParentEmail</div></td><td class="admin-user-cell"><strong>@link.StudentName</strong><div class="small text-muted">@link.StudentEmail</div></td><td><span class="badge @badge">@link.Status</span></td><td>@(link.MonitoringAvailable ? "Available" : "Unavailable")@if (link.Hidden) { <div class="small text-muted">Hidden by a participant</div> }</td><td>@(link.RequestedDate.HasValue ? link.RequestedDate.Value.AddHours(8).ToString("dd MMM yyyy") : "Not recorded")</td><td><a asp-action="Manage" asp-route-id="@link.LinkId" class="btn btn-sm btn-outline-primary">Details</a></td></tr>
        }
        </tbody></table></div><p class="small text-muted mt-3 mb-0">A request grants monitoring access only after the recipient accepts. Active status alone does not override hidden links or unavailable accounts.</p>
        @if (Model.Pages > 1) { <nav class="admin-pagination" aria-label="Relationship pages"><span class="small text-muted">Page @Model.Page of @Model.Pages</span><div class="admin-actions">@if (Model.Page > 1) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)" class="btn btn-sm btn-outline-secondary" data-admin-page>Previous</a> }@if (Model.Page < Model.Pages) { <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)" class="btn btn-sm btn-outline-secondary" data-admin-page>Next</a> }</div></nav> }
    }
</div></div>
