@model IPFMMS.ViewModels.ParentStudentLinkRow
@{ ViewData["Title"] = "Relationship Details"; Layout = "_DashboardLayout"; Func<DateTime?, string> localDate = value => value.HasValue ? value.Value.AddHours(8).ToString("dd MMM yyyy HH:mm") : "Not recorded"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page"><div class="admin-form"><div class="admin-heading"><div><h2 class="fw-bold">Relationship Details</h2><p class="text-muted">Request history and current monitoring availability.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to relationships</a></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["WarningMessage"] is string warning) { <div class="alert alert-warning" role="alert">@warning</div> }
    <div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div><dl class="row admin-detail-list mb-0"><dt class="col-sm-4">Relationship ID</dt><dd class="col-sm-8">@Model.LinkId</dd><dt class="col-sm-4">Monitoring account</dt><dd class="col-sm-8"><strong>@Model.ParentName</strong><div>@Model.ParentEmail</div><div class="small text-muted">@Model.ParentId</div></dd><dt class="col-sm-4">Monitored account</dt><dd class="col-sm-8"><strong>@Model.StudentName</strong><div>@Model.StudentEmail</div><div class="small text-muted">@Model.UserId</div></dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4">Monitoring access</dt><dd class="col-sm-8">@(Model.MonitoringAvailable ? "Available" : "Unavailable")</dd><dt class="col-sm-4">Eligible accounts</dt><dd class="col-sm-8">@(Model.AccountsEligible ? "Both accounts are eligible" : "One or both accounts are unavailable")</dd><dt class="col-sm-4">Request version</dt><dd class="col-sm-8">@Model.Version</dd><dt class="col-sm-4">Requested (MYT)</dt><dd class="col-sm-8">@localDate(Model.RequestedDate)</dd><dt class="col-sm-4">Accepted (MYT)</dt><dd class="col-sm-8">@localDate(Model.AcceptedDate)</dd><dt class="col-sm-4">Invitation email sent (MYT)</dt><dd class="col-sm-8">@localDate(Model.EmailSentDate)</dd><dt class="col-sm-4">Hidden by monitoring user (MYT)</dt><dd class="col-sm-8">@localDate(Model.ParentHiddenDate)</dd><dt class="col-sm-4">Hidden by monitored user (MYT)</dt><dd class="col-sm-8">@localDate(Model.StudentHiddenDate)</dd></dl></div></div>
    @if (Model.Status == "Pending" || Model.Status == "Active") {
        var pending = Model.Status == "Pending";
        <div class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5 fw-bold">@(pending ? "Cancel linking request" : "Deactivate relationship")</h3><p>@(pending ? "Cancel this pending request so it can no longer be accepted. The request history will be retained." : "Stop monitoring access for this relationship. Its history will be retained. Any future link requires a new request and fresh recipient acceptance.")</p><form asp-action="@(pending ? "Cancel" : "Deactivate")" method="post"><input name="id" value="@Model.LinkId" type="hidden" /><input name="version" value="@Model.Version" type="hidden" /><input name="stamp" value="@Model.Stamp" type="hidden" /><div class="admin-confirm mb-4"><div class="form-check"><input id="confirmRelationshipAction" type="checkbox" required class="form-check-input" /><label for="confirmRelationshipAction" class="form-check-label">@(pending ? "I want to cancel this linking request." : "I want to deactivate this relationship.")</label></div></div><div class="admin-actions"><a asp-action="Index" class="btn btn-outline-secondary">Keep unchanged</a><button type="submit" class="btn btn-danger">@(pending ? "Cancel request" : "Deactivate relationship")</button></div></form></div></div>
    } else { <div class="alert alert-info mb-0">This relationship cannot grant monitoring access. A new linking request requires the recipient's acceptance.</div> }
</div></div>
