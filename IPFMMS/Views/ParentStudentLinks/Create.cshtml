@model IPFMMS.ViewModels.CreateParentStudentLinkViewModel
@{ ViewData["Title"] = "Create Linking Request"; Layout = "_DashboardLayout"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="container-fluid py-4 admin-page"><div class="admin-form"><div class="admin-heading"><div><h2 class="fw-bold">Create Linking Request</h2><p class="text-muted">Ask one existing user to share monitoring access with another.</p></div></div><div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    @if (Model.Parents.Count < 2 || Model.Students.Count < 2) { <div class="alert alert-info">Two different active user accounts are required to create a request.</div> }
    <div class="mb-4"><label asp-for="ParentId" class="form-label">Monitoring account</label><select asp-for="ParentId" asp-items="Model.Parents" class="form-select" required><option value="">Select the account that will monitor</option></select><span asp-validation-for="ParentId" class="text-danger small"></span></div>
    <div class="mb-4"><label asp-for="UserId" class="form-label">Account to be monitored</label><select asp-for="UserId" asp-items="Model.Students" class="form-select" required><option value="">Select the account receiving the request</option></select><span asp-validation-for="UserId" class="text-danger small"></span></div>
    <div class="alert alert-info">The request starts as Pending. The recipient must accept it from their own account before monitoring is available. Creating a request does not change either user's role.</div>
    <div class="admin-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary" disabled="@(Model.Parents.Count < 2 || Model.Students.Count < 2)">Send linking request</button></div>
</form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
